BR2_x86_64=y
BR2_x86_x86_64_v2=y
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_HEXAOS_PATH)/patches"
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_X86_64_V2_GLIBC_STABLE=y
BR2_TARGET_GENERIC_HOSTNAME="hexaos"
BR2_TARGET_GENERIC_ISSUE="Welcome to hexaOS"
BR2_TARGET_GENERIC_ROOT_PASSWD=""
BR2_TARGET_GENERIC_GETTY_PORT="tty2"
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
# Wired DHCP for any card name is handled by etc/init.d/S41wired
BR2_SYSTEM_DHCP=""
BR2_GENERATE_LOCALE="en_US.UTF-8"
BR2_TARGET_TZ_INFO=y
BR2_TARGET_LOCALTIME="America/Sao_Paulo"
BR2_ROOTFS_DEVICE_TABLE="system/device_table.txt $(BR2_EXTERNAL_HEXAOS_PATH)/board/hexaos/device_table.txt"
# Prebuilt binaries (Firefox, VS Code) are already optimized: do not strip
BR2_STRIP_EXCLUDE_DIRS="/opt"
BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_HEXAOS_PATH)/board/hexaos/users.txt"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_HEXAOS_PATH)/board/hexaos/rootfs_overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_HEXAOS_PATH)/board/hexaos/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_HEXAOS_PATH)/board/hexaos/post-image.sh"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_LATEST_VERSION=y
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_HEXAOS_PATH)/board/hexaos/linux.fragment"
BR2_LINUX_KERNEL_INSTALL_TARGET=y
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
# Firmware: AX211 Wi-Fi, Intel graphics, CPU microcode
# (the Meteor Lake AX211 files, iwlwifi-ma-*, are added in external.mk)
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_6E=y
BR2_PACKAGE_LINUX_FIRMWARE_I915=y
BR2_PACKAGE_INTEL_MICROCODE=y
# Fonts
BR2_PACKAGE_DEJAVU=y
# Desktop: Weston + foot terminal + boot splash
BR2_PACKAGE_WESTON=y
BR2_PACKAGE_WESTON_DEFAULT_DRM=y
BR2_PACKAGE_WESTON_WAYLAND=y
BR2_PACKAGE_WESTON_SHELL_DESKTOP=y
BR2_PACKAGE_WESTON_DEMO_CLIENTS=y
BR2_PACKAGE_FOOT=y
BR2_PACKAGE_PSPLASH=y
BR2_PACKAGE_PSPLASH_IMAGE="$(BR2_EXTERNAL_HEXAOS_PATH)/board/hexaos/art/splash-logo.png"
BR2_PACKAGE_SEATD=y
BR2_PACKAGE_SEATD_DAEMON=y
# Audio
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_ALSAMIXER=y
BR2_PACKAGE_ALSA_UTILS_SPEAKER_TEST=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
# Speaker amplifiers of the Galaxy Book4 Pro (MAX98390 driver)
BR2_PACKAGE_HEXA_MAX98390=y
# Settings app (hexa-settings) and network time
BR2_PACKAGE_DIALOG=y
BR2_PACKAGE_CHRONY=y
# Network: Wi-Fi with iwd (iwctl command)
BR2_PACKAGE_DBUS=y
BR2_PACKAGE_IWD=y
BR2_PACKAGE_WIRELESS_REGDB=y
# Wi-Fi DNS: iwd hands the DNS servers to resolvconf (see etc/iwd/main.conf)
BR2_PACKAGE_OPENRESOLV=y
# HTTPS (curl + certificates) and git: required by Claude Code
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y
BR2_PACKAGE_LIBCURL_OPENSSL=y
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_GIT=y
# Own packages: 64-bit Wine (WoW64) and SOF audio firmware
BR2_PACKAGE_HEXA_WINE=y
BR2_PACKAGE_HEXA_SOF_BIN=y
# Intel graphics acceleration: OpenGL (iris), Vulkan (ANV), hardware video (VA-API)
# llvmpipe = software OpenGL when there is no Intel GPU (e.g. QEMU)
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_LLVM=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_IRIS=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_LLVMPIPE=y
BR2_PACKAGE_MESA3D_VULKAN_DRIVER_INTEL=y
BR2_PACKAGE_MESA3D_GBM=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
# GLX (OpenGL on X11): libepoxy needs it for GTK3's X11 backend (Xwayland apps, Wine)
BR2_PACKAGE_MESA3D_OPENGL_GLX=y
BR2_PACKAGE_VULKAN_LOADER=y
BR2_PACKAGE_LIBVA=y
BR2_PACKAGE_INTEL_MEDIADRIVER=y
# X11 libraries (no X server) for Firefox/VS Code, and Xwayland for X11 apps
BR2_PACKAGE_XORG7=y
BR2_PACKAGE_LIBEPOXY=y
BR2_PACKAGE_WESTON_XWAYLAND=y
BR2_PACKAGE_LIBGTK3=y
BR2_PACKAGE_LIBGTK3_WAYLAND=y
BR2_PACKAGE_LIBGTK3_X11=y
BR2_PACKAGE_ADWAITA_ICON_THEME=y
BR2_PACKAGE_HICOLOR_ICON_THEME=y
BR2_PACKAGE_SHARED_MIME_INFO=y
BR2_PACKAGE_LIBERATION=y
# Sound: PipeWire (with a PulseAudio server for the browser, Wine and games)
BR2_PACKAGE_PIPEWIRE=y
BR2_PACKAGE_WIREPLUMBER=y
BR2_PACKAGE_LUA=y
BR2_PACKAGE_LUA_5_4=y
BR2_PACKAGE_PULSEAUDIO=y
# Flatpak: Flathub apps and the hexaOS apps in apps/ (installed per user)
BR2_PACKAGE_FLATPAK=y
# VPN: WireGuard (wg, wg-quick; used by hexa-vpn). wg-quick needs the full
# "ip" from iproute2 (BusyBox's cannot add WireGuard links or fwmark rules)
BR2_PACKAGE_WIREGUARD_TOOLS=y
BR2_PACKAGE_WIREGUARD_TOOLS_WG_QUICK=y
BR2_PACKAGE_IPROUTE2=y
# Web and development
BR2_PACKAGE_HEXA_FIREFOX=y
BR2_PACKAGE_HEXA_VSCODE=y
BR2_PACKAGE_HEXA_DXVK=y
BR2_PACKAGE_HEXA_TASKMGR=y
BR2_PACKAGE_HEXA_SETTINGS=y
BR2_PACKAGE_HEXA_POWER=y
# File manager (hexa-files)
BR2_PACKAGE_HEXA_FILES=y
# Flatpak: apps from Flathub (Steam, with its own 32-bit libraries)
BR2_PACKAGE_HEXA_FLATPAK=y
BR2_PACKAGE_DOCKER_ENGINE=y
BR2_PACKAGE_DOCKER_CLI=y
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON3_PY_PYC=y
BR2_PACKAGE_PYTHON3_BZIP2=y
BR2_PACKAGE_PYTHON3_CURSES=y
BR2_PACKAGE_PYTHON3_DECIMAL=y
BR2_PACKAGE_PYTHON3_READLINE=y
BR2_PACKAGE_PYTHON3_SSL=y
BR2_PACKAGE_PYTHON3_SQLITE=y
BR2_PACKAGE_PYTHON3_UNICODEDATA=y
BR2_PACKAGE_PYTHON3_XZ=y
BR2_PACKAGE_PYTHON3_ZLIB=y
BR2_PACKAGE_PYTHON_PIP=y
BR2_PACKAGE_OPENSSH=y
# BR2_PACKAGE_OPENSSH_SERVER is not set
BR2_PACKAGE_SUDO=y
# System: ABNT2 keyboard on the console, grow the partition on first boot
BR2_PACKAGE_KBD=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS_RESIZE2FS=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_UTIL_LINUX_PARTX=y
BR2_PACKAGE_XZ=y
BR2_PACKAGE_UNZIP=y
BR2_PACKAGE_ZIP=y
BR2_PACKAGE_FILE=y
BR2_PACKAGE_LESS=y
# Tools
BR2_PACKAGE_BASH=y
BR2_PACKAGE_BASH_COMPLETION=y
BR2_PACKAGE_HTOP=y
BR2_PACKAGE_NANO=y
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_KMOD_TOOLS=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="6G"
# BR2_TARGET_ROOTFS_TAR is not set
BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_X86_64_EFI=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y
