%!PS
% 24x24 panel icon: hexaOS Setup (a check mark)
(common.ps) run
gsave
  12 12 11.5 hexpath clip
  << /ShadingType 2 /ColorSpace /DeviceRGB /Coords [0 24 24 0]
     /Function << /FunctionType 2 /Domain [0 1] /C0 [cyan] /C1 [blue] /N 1 >>
     /Extend [true true] >> shfill
grestore
bg setrgbcolor 2.8 setlinewidth 1 setlinecap 1 setlinejoin
newpath 6.5 12.5 moveto 10.5 8.3 lineto 17.5 16.5 lineto stroke
showpage
