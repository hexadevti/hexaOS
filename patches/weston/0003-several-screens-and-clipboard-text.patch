+static bool
+is_text_type(const char *type)
+{
+	size_t i;
+
+	for (i = 0; i < ARRAY_LENGTH(text_types); i++) {
+		if (strcmp(type, text_types[i]) == 0)
+			return true;
+	}
+	return false;
+}
+
+/* The type to keep a copy of: the best text type offered, else the first */
+static const char *
+clipboard_pick_type(struct wl_array *offered)
+{
+	size_t i;
+
+	for (i = 0; i < ARRAY_LENGTH(text_types); i++) {
+		if (mime_list_has(offered, text_types[i]))
+			return text_types[i];
+	}
+	return *(const char **) offered->data;
+}
+
+/* Types our copy is offered as: the kept one, the program's other names for
+ * plain text, and the usual UTF-8 names when the copy is UTF-8 */
+static bool
+clipboard_fill_types(struct wl_array *types, struct wl_array *offered,
+		     const char *kept)
+{
+	char **s;
+	size_t i;
+
+	if (!mime_list_add(types, kept))
+		return false;
+	if (!is_text_type(kept))
+		return true;
+
+	wl_array_for_each(s, offered) {
+		if (is_text_type(*s) && !mime_list_add(types, *s))
+			return false;
+	}
+	if (strcmp(kept, "text/plain;charset=utf-8") == 0 ||
+	    strcmp(kept, "UTF8_STRING") == 0) {
+		for (i = 0; i < ARRAY_LENGTH(utf8_aliases); i++) {
+			if (!mime_list_add(types, utf8_aliases[i]))
+				return false;
+		}
+	}
+	return true;
+}
