+/*
+ * Drawing helpers
+ */
+
+static void
+set_hex_color(cairo_t *cr, uint32_t color)
+{
+	cairo_set_source_rgba(cr,
+			      ((color >> 16) & 0xff) / 255.0,
+			      ((color >>  8) & 0xff) / 255.0,
+			      ((color >>  0) & 0xff) / 255.0,
+			      ((color >> 24) & 0xff) / 255.0);
+}
+
+static void
+path_rounded_rect(cairo_t *cr, double x, double y, double w, double h, double r)
+{
+	if (r > w / 2)
+		r = w / 2;
+	if (r > h / 2)
+		r = h / 2;
+	cairo_new_sub_path(cr);
+	cairo_arc(cr, x + w - r, y + r, r, -M_PI / 2, 0);
+	cairo_arc(cr, x + w - r, y + h - r, r, 0, M_PI / 2);
+	cairo_arc(cr, x + r, y + h - r, r, M_PI / 2, M_PI);
+	cairo_arc(cr, x + r, y + r, r, M_PI, 3 * M_PI / 2);
+	cairo_close_path(cr);
+}
+
+static void
+path_hexagon(cairo_t *cr, double cx, double cy, double r)
+{
+	int i;
+
+	cairo_new_sub_path(cr);
+	for (i = 0; i < 6; i++) {
+		double a = (60.0 * i + 30.0) * M_PI / 180.0;
+		cairo_line_to(cr, cx + r * cos(a), cy + r * sin(a));
+	}
+	cairo_close_path(cr);
+}
+
+/* The hexaOS logo: cyan hexagon ring, blue->cyan inner hexagon, an "H" */
+static void
+draw_logo(cairo_t *cr, double cx, double cy, double r, double alpha)
+{
+	cairo_pattern_t *pat;
+
+	cairo_save(cr);
+	cairo_set_line_join(cr, CAIRO_LINE_JOIN_ROUND);
+	cairo_set_line_width(cr, r * 0.13);
+	cairo_set_source_rgba(cr, HEXA_CYAN, alpha);
+	path_hexagon(cr, cx, cy, r);
+	cairo_stroke(cr);
+
+	path_hexagon(cr, cx, cy, r * 0.62);
+	pat = cairo_pattern_create_linear(cx - r, cy + r, cx + r, cy - r);
+	cairo_pattern_add_color_stop_rgba(pat, 0, HEXA_BLUE, alpha);
+	cairo_pattern_add_color_stop_rgba(pat, 1, HEXA_CYAN, alpha);
+	cairo_set_source(cr, pat);
+	cairo_fill(cr);
+	cairo_pattern_destroy(pat);
+
+	cairo_set_source_rgba(cr, HEXA_BG, alpha);
+	cairo_set_line_width(cr, r * 0.10);
+	cairo_move_to(cr, cx - r * 0.20, cy - r * 0.30);
+	cairo_rel_line_to(cr, 0, r * 0.60);
+	cairo_move_to(cr, cx + r * 0.20, cy - r * 0.30);
+	cairo_rel_line_to(cr, 0, r * 0.60);
+	cairo_move_to(cr, cx - r * 0.20, cy);
+	cairo_rel_line_to(cr, r * 0.40, 0);
+	cairo_stroke(cr);
+	cairo_restore(cr);
+}
