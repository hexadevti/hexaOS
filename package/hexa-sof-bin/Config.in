config BR2_PACKAGE_HEXA_SOF_BIN
	bool "hexa-sof-bin (Intel SOF audio firmware)"
	depends on BR2_x86_64
	help
	  Sound Open Firmware binaries and topologies for the audio DSP
	  of Intel Core Ultra (Meteor Lake) processors.
	  Installs only what "mtl" needs into /lib/firmware/intel.

	  https://github.com/thesofproject/sof-bin
