+/*
+ * hexaOS: where a new window opens. On the screen under the pointer, inside
+ * its work area (the taskbar excluded). A window bigger than that screen
+ * (e.g. it remembered its size from a bigger or less scaled screen) is asked
+ * to fit it, and is centered when its new size arrives.
+ */
+static void
+place_new_window(struct desktop_shell *shell, struct shell_surface *shsurf)
+{
+	struct weston_compositor *compositor = shell->compositor;
+	struct weston_surface *surface =
+		weston_desktop_surface_get_surface(shsurf->desktop_surface);
+	struct weston_output *output, *target = NULL;
+	struct weston_seat *seat;
+	struct weston_coord_global pos;
+	struct weston_coord_surface offset;
+	struct weston_geometry geo;
+	pixman_rectangle32_t area;
+	int32_t x, y, w, h;
+
+	pos.c = weston_coord(0, 0);
+	wl_list_for_each(seat, &compositor->seat_list, link) {
+		struct weston_pointer *pointer = weston_seat_get_pointer(seat);
+
+		if (pointer) {
+			pos = pointer->pos;
+			break;
+		}
+	}
+	wl_list_for_each(output, &compositor->output_list, link) {
+		if (!output->destroying &&
+		    weston_output_contains_coord(output, pos)) {
+			target = output;
+			break;
+		}
+	}
+	if (!target)
+		target = weston_shell_utils_get_default_output(compositor);
+	if (!target) {
+		weston_view_set_initial_position(shsurf->view, shell);
+		return;
+	}
+
+	get_output_work_area(shell, target, &area);
+	geo = weston_desktop_surface_get_geometry(shsurf->desktop_surface);
+	if (geo.width <= 0 || geo.height <= 0) {
+		geo.x = 0;
+		geo.y = 0;
+		geo.width = surface->width;
+		geo.height = surface->height;
+	}
+
+	w = geo.width;
+	h = geo.height;
+	if (w > (int32_t) area.width || h > (int32_t) area.height) {
+		w = MIN(w, (int32_t) area.width);
+		h = MIN(h, (int32_t) area.height);
+		weston_desktop_surface_set_size(shsurf->desktop_surface, w, h);
+		shsurf->recenter_output = target;
+		x = area.x;
+		y = area.y;
+	} else {
+		x = area.x;
+		y = area.y;
+		if ((int32_t) area.width > w)
+			x += random() % ((int32_t) area.width - w + 1);
+		if ((int32_t) area.height > h)
+			y += random() % ((int32_t) area.height - h + 1);
+	}
+
+	pos.c = weston_coord(x, y);
+	offset = weston_coord_surface(-geo.x, -geo.y, shsurf->view->surface);
+	weston_view_set_position_with_offset(shsurf->view, pos, offset);
+}
+
+/* After place_new_window asked a window to fit its screen: once it does,
+ * center it there (it may take a few commits for the new size to come) */
+static void
+recenter_if_it_fits(struct shell_surface *shsurf)
+{
+	struct weston_surface *surface =
+		weston_desktop_surface_get_surface(shsurf->desktop_surface);
+	struct weston_output *o, *output = NULL;
+	struct weston_geometry geo;
+	pixman_rectangle32_t area;
+
+	wl_list_for_each(o, &surface->compositor->output_list, link)
+		if (o == shsurf->recenter_output && !o->destroying)
+			output = o;
+	if (!output) {
+		shsurf->recenter_output = NULL;
+		return;
+	}
+
+	get_output_work_area(shsurf->shell, output, &area);
+	geo = weston_desktop_surface_get_geometry(shsurf->desktop_surface);
+	if (geo.width > (int32_t) area.width || geo.height > (int32_t) area.height)
+		return;
+	shell_surface_center_on_output(shsurf, output);
+	shsurf->recenter_output = NULL;
+}
