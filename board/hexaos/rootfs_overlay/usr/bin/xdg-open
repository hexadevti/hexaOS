#!/bin/sh
# Minimal xdg-open (hexaOS has no desktop environment): VS Code opens the
# GitHub/Microsoft login page with it, and Firefox sends the vscode:// reply back.
# vscode:// links -> VS Code; folders -> Files (hexa-files); web pages and
# other files -> the default browser chosen in Settings > Default apps
# (~/.config/mimeapps.list), Firefox when none was chosen.
[ -n "$1" ] || { echo "usage: xdg-open URL|FILE" >&2; exit 1; }
target=$1
case "$target" in
    vscode:*|vscode-insiders:*) exec /usr/bin/code --open-url "$target" ;;
    file://*)
        # file:///path (spaces and such come %-encoded)
        target=$(printf '%s' "${target#file://}" | sed 's/%\([0-9A-Fa-f][0-9A-Fa-f]\)/\x\1/g')
        target=$(printf '%b' "$target") ;;
esac
if [ -d "$target" ]; then
    /usr/bin/hexa-files "$target" >/dev/null 2>&1 &
    exit 0
fi

# Default browser: "gio mime" reads the same mimeapps.list files as GTK apps
browser=
if command -v gio >/dev/null 2>&1; then
    browser=$(gio mime x-scheme-handler/https 2>/dev/null |
              sed -n "s/^Default application for .*: *//p" | head -n 1)
fi
case "$browser" in
    ''|firefox.desktop)
        /usr/bin/firefox "$target" >/dev/null 2>&1 & ;;
    *)
        # another browser (often a Flatpak from the Store): GIO starts it from
        # its .desktop file (gio takes URLs and paths), Firefox if that fails
        ( gio open "$target" >/dev/null 2>&1 ||
          /usr/bin/firefox "$target" >/dev/null 2>&1 ) & ;;
esac
exit 0
