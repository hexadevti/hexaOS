+static void
+context_menu_fill(struct context_menu *ctx, enum ctx_kind kind,
+		  struct task_window *win, struct menu_item *item)
+{
+	struct desktop *desktop = ctx->desktop;
+	struct menu_item *it;
+
+	switch (kind) {
+	case CTX_FOR_WINDOW: {
+		bool minimized = win->flags &
+			WESTON_DESKTOP_SHELL_WINDOW_FLAGS_MINIMIZED;
+		bool maximized = win->flags &
+			WESTON_DESKTOP_SHELL_WINDOW_FLAGS_MAXIMIZED;
+
+		ctx->window_id = win->id;
+		item = item_for_app(desktop, win->app_id);
+		if (item) {
+			context_menu_add(ctx, item->name, CTX_LAUNCH, item, true);
+			if (item->pinned)
+				context_menu_add(ctx, "Unpin from taskbar",
+						 CTX_UNPIN, item, true);
+			else
+				context_menu_add(ctx, "Pin to taskbar",
+						 CTX_PIN, item, true);
+			context_menu_separator(ctx);
+		}
+		context_menu_add(ctx, "Restore", CTX_RESTORE, NULL,
+				 minimized || maximized);
+		context_menu_add(ctx, "Minimize", CTX_MINIMIZE, NULL,
+				 !minimized);
+		context_menu_add(ctx, "Maximize", CTX_MAXIMIZE, NULL,
+				 !maximized);
+		context_menu_separator(ctx);
+		context_menu_add(ctx, "Close window", CTX_CLOSE, NULL, true);
+		break;
+	}
+	case CTX_FOR_LAUNCHER:
+		context_menu_add(ctx, item->name, CTX_LAUNCH, item, true);
+		context_menu_add(ctx, "Unpin from taskbar", CTX_UNPIN, item,
+				 true);
+		break;
+	case CTX_FOR_START:
+		context_menu_add(ctx, "Task Manager", CTX_TASK_MANAGER, NULL,
+				 true);
+		it = item_for_app(desktop, HEXA_SETTINGS_ID);
+		if (it)
+			context_menu_add(ctx, it->name, CTX_LAUNCH, it, true);
+		it = item_for_app(desktop, "foot");
+		if (it)
+			context_menu_add(ctx, it->name, CTX_LAUNCH, it, true);
+		it = item_for_app(desktop, "hexa-power");
+		if (it) {
+			context_menu_separator(ctx);
+			context_menu_add(ctx, "Shut down or sign out",
+					 CTX_LAUNCH, it, true);
+		}
+		break;
+	case CTX_FOR_TASKBAR:
+		context_menu_add(ctx, "Task Manager", CTX_TASK_MANAGER, NULL,
+				 true);
+		context_menu_separator(ctx);
+		context_menu_add(ctx, "Show desktop", CTX_SHOW_DESKTOP, NULL,
+				 !wl_list_empty(&desktop->windows));
+		break;
+	}
+}
