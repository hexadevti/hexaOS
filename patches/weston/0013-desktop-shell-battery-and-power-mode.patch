+/*
+ * Battery (/sys/class/power_supply) and power mode (hexa-power-mode)
+ */
+
+static const char *const power_mode_names[POWER_N_MODES] = {
+	"saver", "balanced", "performance"
+};
+static const char *const power_mode_labels[POWER_N_MODES] = {
+	"Power saver", "Balanced", "Best performance"
+};
+
+/* First line of a small sysfs (or config) file, without the newline */
+static bool
+read_line(const char *path, char *buf, size_t size)
+{
+	FILE *f = fopen(path, "re");
+	bool ok;
+
+	if (!f)
+		return false;
+	ok = fgets(buf, size, f) != NULL;
+	fclose(f);
+	if (ok)
+		buf[strcspn(buf, "\n")] = '\0';
+	return ok;
+}
+
+static bool
+supply_read(const char *supply, const char *name, char *buf, size_t size)
+{
+	char path[256];
+
+	snprintf(path, sizeof path, POWER_SUPPLY_DIR "/%s/%s", supply, name);
+	return read_line(path, buf, size);
+}
+
+static long
+supply_read_long(const char *supply, const char *name, long def)
+{
+	char buf[32];
+
+	if (!supply_read(supply, name, buf, sizeof buf))
+		return def;
+	return strtol(buf, NULL, 10);
+}
+
+/* WORD is one of the space-separated words of the file */
+static bool
+file_has_word(const char *path, const char *word)
+{
+	char buf[512], *w, *save = NULL;
+
+	if (!read_line(path, buf, sizeof buf))
+		return false;
+	for (w = strtok_r(buf, " ", &save); w; w = strtok_r(NULL, " ", &save))
+		if (strcmp(w, word) == 0)
+			return true;
+	return false;
+}
+
+/* Which modes the computer can use: the same rules as hexa-power-mode */
+static void
+power_read_modes(struct power_info *info)
+{
+	const char *gov = CPUFREQ_DIR "/scaling_available_governors";
+	char buf[32];
+	int i;
+
+	if (access(PLATFORM_PROFILE, F_OK) == 0 ||
+	    access(CPUFREQ_DIR "/energy_performance_preference", F_OK) == 0) {
+		for (i = 0; i < POWER_N_MODES; i++)
+			info->has_mode[i] = true;
+	} else {
+		info->has_mode[POWER_SAVER] = file_has_word(gov, "powersave");
+		info->has_mode[POWER_BALANCED] =
+			file_has_word(gov, "schedutil") ||
+			file_has_word(gov, "ondemand") ||
+			file_has_word(gov, "conservative");
+		info->has_mode[POWER_PERFORMANCE] =
+			file_has_word(gov, "performance");
+	}
+	for (i = 0; i < POWER_N_MODES; i++)
+		if (info->has_mode[i])
+			info->n_modes++;
+
+	info->mode = POWER_BALANCED;
+	if (read_line(POWER_MODE_FILE, buf, sizeof buf))
+		for (i = 0; i < POWER_N_MODES; i++)
+			if (strcmp(buf, power_mode_names[i]) == 0)
+				info->mode = i;
+}
+
+/* The computer's batteries (not a mouse's) added up, and the charger */
+static void
+power_read_battery(struct power_info *info)
+{
+	long now_sum = 0, full_sum = 0, rate_sum = 0, cap_sum = 0;
+	int n = 0, n_cap = 0;
+	bool discharging = false;
+	struct dirent *de;
+	DIR *dir;
+
+	info->minutes = -1;
+	dir = opendir(POWER_SUPPLY_DIR);
+	if (!dir)
+		return;
+	while ((de = readdir(dir))) {
+		const char *name = de->d_name;
+		char type[32], buf[32];
+		long now, full, rate;
+
+		if (name[0] == '.' || !supply_read(name, "type", type, sizeof type))
+			continue;
+		/* peripherals (mouse, gamepad) say scope "Device" */
+		if (supply_read(name, "scope", buf, sizeof buf) &&
+		    strcmp(buf, "Device") == 0)
+			continue;
+		if (strcmp(type, "Battery") != 0) {
+			/* Mains, USB (USB-C chargers)... */
+			if (supply_read_long(name, "online", 0) > 0)
+				info->plugged = true;
+			continue;
+		}
+		if (supply_read_long(name, "present", 1) == 0)
+			continue;
+
+		n++;
+		if (supply_read(name, "status", buf, sizeof buf)) {
+			if (strcmp(buf, "Charging") == 0)
+				info->charging = true;
+			else if (strcmp(buf, "Discharging") == 0)
+				discharging = true;
+			else if (strcmp(buf, "Full") == 0 ||
+				 strcmp(buf, "Not charging") == 0)
+				info->plugged = true;
+		}
+		if ((now = supply_read_long(name, "capacity", -1)) >= 0) {
+			cap_sum += now;
+			n_cap++;
+		}
+		/* energy (uWh, uW) or charge (uAh, uA), depending on the
+		 * firmware */
+		now = supply_read_long(name, "energy_now", -1);
+		if (now >= 0) {
+			full = supply_read_long(name, "energy_full", 0);
+			rate = supply_read_long(name, "power_now", 0);
+		} else {
+			now = supply_read_long(name, "charge_now", -1);
+			full = supply_read_long(name, "charge_full", 0);
+			rate = supply_read_long(name, "current_now", 0);
+		}
+		if (now >= 0 && full > 0) {
+			now_sum += now;
+			full_sum += full;
+			rate_sum += labs(rate);
+		}
+	}
+	closedir(dir);
+
+	if (n == 0)
+		return;
+	info->battery = true;
+	if (info->charging)
+		info->plugged = true;
+	if (n == 1 && n_cap == 1)
+		info->percent = cap_sum;
+	else if (full_sum > 0)
+		info->percent = (int) ((now_sum * 100 + full_sum / 2) / full_sum);
+	else if (n_cap > 0)
+		info->percent = cap_sum / n_cap;
+	if (info->percent > 100)
+		info->percent = 100;
+
+	if (rate_sum > 0 && full_sum > 0) {
+		long left = info->charging ? full_sum - now_sum :
+			    discharging ? now_sum : -1;
+
+		if (left >= 0)
+			info->minutes = (int) (left * 60 / rate_sum);
+		/* the first readings after a change are often silly */
+		if (info->minutes > 48 * 60)
+			info->minutes = -1;
+	}
+}
+
+static void
+power_read(struct power_state *ps)
+{
+	struct power_info info;
+
+	memset(&info, 0, sizeof info);
+	power_read_battery(&info);
+	power_read_modes(&info);
+	if (memcmp(&info, &ps->info, sizeof info) != 0) {
+		ps->info = info;
+		panels_update(ps->desktop);
+	}
+}
+
+static void
+power_timer_func(struct toytimer *tt)
+{
+	power_read(container_of(tt, struct power_state, timer));
+}
+
+/* Reads again in SECONDS (after a change), then as usual */
+static void
+power_poll_in(struct power_state *ps, int seconds)
+{
+	struct itimerspec its = {
+		.it_interval = { .tv_sec = POWER_POLL_SECONDS },
+		.it_value = { .tv_sec = seconds },
+	};
+
+	toytimer_arm(&ps->timer, &its);
+}
+
+static void
+power_set_mode(struct power_state *ps, enum power_mode mode)
+{
+	char cmd[96];
+
+	if (mode >= POWER_N_MODES || !ps->info.has_mode[mode])
+		return;
+	snprintf(cmd, sizeof cmd, HEXA_POWER_MODE " set %s",
+		 power_mode_names[mode]);
+	run_command(cmd);
+	/* show it right away; the next reading confirms it */
+	ps->info.mode = mode;
+	panels_update(ps->desktop);
+	power_poll_in(ps, 2);
+}
+
+static int
+power_width(struct desktop *desktop)
+{
+	struct power_info *info = &desktop->power.info;
+
+	if (info->battery)
+		return BATTERY_WIDTH;
+	return info->n_modes > 0 ? POWER_WIDTH : 0;
+}
+
+/* "2 h 05 min", "40 min" */
+static void
+format_minutes(char *buf, size_t size, int minutes)
+{
+	if (minutes >= 60)
+		snprintf(buf, size, "%d h %02d min", minutes / 60, minutes % 60);
+	else
+		snprintf(buf, size, "%d min", minutes);
+}
+
+/* "79% - 3 h 10 min left", "45% - charging", "100% - plugged in" */
+static void
+power_battery_text(struct power_info *info, char *buf, size_t size)
+{
+	char t[32];
+
+	if (info->minutes >= 0)
+		format_minutes(t, sizeof t, info->minutes);
+	if (info->charging && info->minutes >= 0)
+		snprintf(buf, size, "%d%% - charging, full in %s",
+			 info->percent, t);
+	else if (info->charging)
+		snprintf(buf, size, "%d%% - charging", info->percent);
+	else if (info->plugged)
+		snprintf(buf, size, "%d%% - plugged in", info->percent);
+	else if (info->minutes >= 0)
+		snprintf(buf, size, "%d%% - %s left", info->percent, t);
+	else
+		snprintf(buf, size, "%d%% - on battery", info->percent);
+}
+
+/* A battery W wide, from X, centered on CY, filled to PERCENT */
+static void
+draw_battery(cairo_t *cr, double x, double cy, double w, int percent,
+	     bool charging, bool plugged, double alpha)
+{
+	double h = w * 0.5, fill;
+	bool low = percent <= 10 && !plugged;
+
+	cairo_save(cr);
+	cairo_set_line_width(cr, 1.4);
+	cairo_set_source_rgba(cr, 1, 1, 1, alpha);
+	path_rounded_rect(cr, x + 0.7, cy - h / 2, w - 3, h, 2);
+	cairo_stroke(cr);
+	/* the terminal */
+	cairo_rectangle(cr, x + w - 2, cy - h / 4, 2, h / 2);
+	cairo_fill(cr);
+
+	fill = (w - 3 - 4) * (percent < 0 ? 0 : percent > 100 ? 100 : percent) / 100.0;
+	if (fill > 0) {
+		if (low)
+			cairo_set_source_rgba(cr, 0.937, 0.267, 0.267, alpha);
+		else if (charging)
+			cairo_set_source_rgba(cr, HEXA_CYAN, alpha);
+		cairo_rectangle(cr, x + 2.7, cy - h / 2 + 2, fill, h - 4);
+		cairo_fill(cr);
+	}
+
+	/* a lightning bolt on the charger */
+	if (plugged) {
+		double bx = x + (w - 3) / 2 + 0.7, s = h * 0.62;
+
+		cairo_move_to(cr, bx + s * 0.25, cy - s);
+		cairo_line_to(cr, bx - s * 0.45, cy + s * 0.12);
+		cairo_line_to(cr, bx - s * 0.02, cy + s * 0.12);
+		cairo_line_to(cr, bx - s * 0.25, cy + s);
+		cairo_line_to(cr, bx + s * 0.45, cy - s * 0.12);
+		cairo_line_to(cr, bx + s * 0.02, cy - s * 0.12);
+		cairo_close_path(cr);
+		cairo_set_source_rgba(cr, 1, 1, 1, alpha);
+		cairo_fill_preserve(cr);
+		cairo_set_source_rgb(cr, HEXA_BG);
+		cairo_set_line_width(cr, 1);
+		cairo_stroke(cr);
+	}
+	cairo_restore(cr);
+}
+
+/* A gauge of radius R centered on (CX, CY) with its needle on MODE */
+static void
+draw_gauge(cairo_t *cr, double cx, double cy, double r, enum power_mode mode)
+{
+	static const double needle[POWER_N_MODES] = {
+		M_PI + 0.55, 1.5 * M_PI, 2 * M_PI - 0.55
+	};
+	double t = needle[mode < POWER_N_MODES ? mode : POWER_BALANCED];
+
+	cairo_new_sub_path(cr);
+	cairo_arc(cr, cx, cy, r, M_PI - 0.25, 2 * M_PI + 0.25);
+	cairo_move_to(cr, cx, cy);
+	cairo_line_to(cr, cx + r * 0.72 * cos(t), cy + r * 0.72 * sin(t));
+}
+
+static void
+panel_power_redraw_handler(struct widget *widget, void *data)
+{
+	struct panel *panel = data;
+	struct power_info *info = &panel->desktop->power.info;
+	struct rectangle a;
+	char text[16];
+	double cy;
+	cairo_t *cr;
+
+	widget_get_allocation(widget, &a);
+	if (a.width == 0)
+		return;
+
+	cr = widget_cairo_create(panel->widget);
+	draw_button_bg(cr, &a, panel->power_hover ? 0.10 : 0);
+	cy = a.y + a.height / 2.0;
+	if (info->battery) {
+		draw_battery(cr, a.x + 8, cy, 24, info->percent,
+			     info->charging, info->plugged, 0.95);
+		snprintf(text, sizeof text, "%d%%", info->percent);
+		set_font(cr, 12, false);
+		cairo_set_source_rgba(cr, 1, 1, 1, 0.85);
+		cairo_move_to(cr, a.x + 37, cy + 4.5);
+		cairo_show_text(cr, text);
+	} else {
+		cairo_set_source_rgba(cr, 1, 1, 1, 0.95);
+		cairo_set_line_width(cr, 1.6);
+		cairo_set_line_cap(cr, CAIRO_LINE_CAP_ROUND);
+		draw_gauge(cr, a.x + a.width / 2.0, cy + 3, 8, info->mode);
+		cairo_stroke(cr);
+	}
+	cairo_destroy(cr);
+}
+
+static int
+panel_power_enter_handler(struct widget *widget, struct input *input,
+			  float x, float y, void *data)
+{
+	struct panel *panel = data;
+
+	panel->power_hover = 1;
+	widget_schedule_redraw(widget);
+	return CURSOR_LEFT_PTR;
+}
+
+static void
+panel_power_leave_handler(struct widget *widget, struct input *input,
+			  void *data)
+{
+	struct panel *panel = data;
+
+	panel->power_hover = 0;
+	widget_destroy_tooltip(widget);
+	widget_schedule_redraw(widget);
+}
+
+static int
+panel_power_motion_handler(struct widget *widget, struct input *input,
+			   uint32_t time, float x, float y, void *data)
+{
+	struct panel *panel = data;
+	struct power_state *ps = &panel->desktop->power;
+	struct power_info *info = &ps->info;
+	const char *mode = power_mode_labels[info->mode];
+	char battery[96];
+
+	if (power_width(panel->desktop) == 0)
+		return CURSOR_LEFT_PTR;
+	if (info->battery) {
+		power_battery_text(info, battery, sizeof battery);
+		if (info->n_modes > 0)
+			snprintf(ps->tooltip, sizeof ps->tooltip,
+				 "Battery %s (%s)", battery, mode);
+		else
+			snprintf(ps->tooltip, sizeof ps->tooltip,
+				 "Battery %s", battery);
+	} else {
+		snprintf(ps->tooltip, sizeof ps->tooltip, "Power mode: %s",
+			 mode);
+	}
+	widget_set_tooltip(widget, ps->tooltip, x, y);
+	return CURSOR_LEFT_PTR;
+}
+
+static void
+panel_power_button_handler(struct widget *widget, struct input *input,
+			   uint32_t time, uint32_t button,
+			   enum wl_pointer_button_state state, void *data)
+{
+	struct panel *panel = data;
+	struct rectangle a;
+
+	widget_destroy_tooltip(widget);
+	popups_close(panel->desktop);
+	if ((button != BTN_LEFT && button != BTN_RIGHT) ||
+	    state != WL_POINTER_BUTTON_STATE_RELEASED ||
+	    power_width(panel->desktop) == 0)
+		return;
+	/* fresh numbers in the menu */
+	power_read(&panel->desktop->power);
+	widget_get_allocation(widget, &a);
+	context_menu_open(panel, CTX_FOR_POWER, a.x, NULL, NULL);
+}
+
+static void
+panel_power_touch_down_handler(struct widget *widget, struct input *input,
+			       uint32_t serial, uint32_t time, int32_t id,
+			       float x, float y, void *data)
+{
+	struct panel *panel = data;
+	struct rectangle a;
+
+	if (power_width(panel->desktop) == 0)
+		return;
+	power_read(&panel->desktop->power);
+	widget_get_allocation(widget, &a);
+	context_menu_open(panel, CTX_FOR_POWER, a.x, NULL, NULL);
+}
