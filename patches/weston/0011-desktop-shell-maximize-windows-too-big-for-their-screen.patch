+/* The screen OUTPUT if it is still connected, else NULL */
+static struct weston_output *
+live_output(struct weston_compositor *compositor, struct weston_output *output)
+{
+	struct weston_output *o;
+
+	if (!output)
+		return NULL;
+	wl_list_for_each(o, &compositor->output_list, link)
+		if (o == output && !o->destroying)
+			return o;
+	return NULL;
+}
+
+/* The window's visible size (without client-side shadows) */
+static struct weston_geometry
+window_geometry(struct shell_surface *shsurf)
+{
+	struct weston_surface *surface =
+		weston_desktop_surface_get_surface(shsurf->desktop_surface);
+	struct weston_geometry geo;
+
+	geo = weston_desktop_surface_get_geometry(shsurf->desktop_surface);
+	if (geo.width <= 0 || geo.height <= 0) {
+		geo.x = 0;
+		geo.y = 0;
+		geo.width = surface->width;
+		geo.height = surface->height;
+	}
+	return geo;
+}
+
+#define HEXA_FIT_TIMEOUT_MS 1000
+
+/*
+ * hexaOS: a window was asked to fit its screen and has had a moment to do
+ * it. Apps that ignore the size they are given, or cannot get that small
+ * (their minimum size is bigger), would stay partly off the screen and under
+ * the taskbar: they are maximized on that screen instead, which makes them
+ * exactly as big as its work area. Fixed-size windows are left alone.
+ */
+static int
+fit_timer_done(void *data)
+{
+	struct shell_surface *shsurf = data;
+	struct weston_output *output;
+	struct weston_geometry geo;
+	struct weston_size min, max;
+	pixman_rectangle32_t area;
+
+	if (!shsurf->desktop_surface || !shsurf->recenter_output)
+		return 0;
+	output = live_output(shsurf->shell->compositor, shsurf->recenter_output);
+	shsurf->recenter_output = NULL;
+	if (!output || shsurf->state.fullscreen || shsurf->state.maximized)
+		return 0;
+
+	get_output_work_area(shsurf->shell, output, &area);
+	geo = window_geometry(shsurf);
+	if (geo.width <= (int32_t) area.width && geo.height <= (int32_t) area.height) {
+		shell_surface_center_on_output(shsurf, output);
+		return 0;
+	}
+
+	min = weston_desktop_surface_get_min_size(shsurf->desktop_surface);
+	max = weston_desktop_surface_get_max_size(shsurf->desktop_surface);
+	if (min.width > 0 && min.width == max.width &&
+	    min.height > 0 && min.height == max.height)
+		return 0;
+
+	weston_log("hexaOS: window \"%s\" (%dx%d) is bigger than its screen "
+		   "%s (%ux%u): maximizing it\n",
+		   weston_desktop_surface_get_title(shsurf->desktop_surface) ?: "",
+		   geo.width, geo.height, output->name, area.width, area.height);
+	shsurf->keep_on_screen = false;
+	set_maximized_on(shsurf, true, output);
+	return 0;
+}
+
+/*
+ * hexaOS: asks a window bigger than OUTPUT's work area to fit it (W x H).
+ * It is centered there once its new size arrives (recenter_if_it_fits), or
+ * maximized there if it is still too big a moment later (fit_timer_done).
+ */
+static void
+ask_window_to_fit(struct shell_surface *shsurf, struct weston_output *output,
+		  int32_t w, int32_t h)
+{
+	struct wl_event_loop *loop =
+		wl_display_get_event_loop(shsurf->shell->compositor->wl_display);
+
+	weston_desktop_surface_set_size(shsurf->desktop_surface, w, h);
+	shsurf->recenter_output = output;
+	if (!shsurf->fit_timer)
+		shsurf->fit_timer = wl_event_loop_add_timer(loop, fit_timer_done,
+							    shsurf);
+	if (shsurf->fit_timer)
+		wl_event_source_timer_update(shsurf->fit_timer,
+					     HEXA_FIT_TIMEOUT_MS);
+}
