+/*
+ * hexaOS taskbar: tells the panel (weston-desktop-shell) about top-level
+ * windows, and lets it activate, minimize or close them.
+ */
+
+static bool
+taskbar_wants(struct shell_surface *shsurf)
+{
+	struct weston_surface *surface;
+
+	if (!shsurf->desktop_surface || shsurf->destroying)
+		return false;
+	if (weston_desktop_surface_get_parent(shsurf->desktop_surface))
+		return false;
+
+	surface = weston_desktop_surface_get_surface(shsurf->desktop_surface);
+	return weston_surface_is_mapped(surface);
+}
+
+static struct wl_resource *
+taskbar_resource(struct desktop_shell *shell)
+{
+	struct wl_resource *res = shell->child.desktop_shell;
+
+	if (res && wl_resource_get_version(res) >= 2)
+		return res;
+	return NULL;
+}
+
+static void
+taskbar_remove(struct shell_surface *shsurf)
+{
+	struct wl_resource *res;
+
+	if (!shsurf->tb.shown)
+		return;
+
+	shsurf->tb.shown = false;
+	res = taskbar_resource(shsurf->shell);
+	if (res)
+		weston_desktop_shell_send_window_removed(res, shsurf->tb.id);
+}
+
+static bool
+str_equal(const char *a, const char *b)
+{
+	return a && b && strcmp(a, b) == 0;
+}
+
+static void
+taskbar_update(struct shell_surface *shsurf)
+{
+	struct desktop_shell *shell = shsurf->shell;
+	struct wl_resource *res;
+	const char *title, *app_id;
+	uint32_t flags = 0;
+
+	if (!taskbar_wants(shsurf)) {
+		taskbar_remove(shsurf);
+		return;
+	}
+
+	title = weston_desktop_surface_get_title(shsurf->desktop_surface);
+	app_id = weston_desktop_surface_get_app_id(shsurf->desktop_surface);
+	if (!title)
+		title = "";
+	if (!app_id)
+		app_id = "";
+
+	if (weston_desktop_surface_get_activated(shsurf->desktop_surface))
+		flags |= WESTON_DESKTOP_SHELL_WINDOW_FLAGS_ACTIVATED;
+	if (shsurf->view->layer_link.layer == &shell->minimized_layer)
+		flags |= WESTON_DESKTOP_SHELL_WINDOW_FLAGS_MINIMIZED;
+	if (weston_desktop_surface_get_maximized(shsurf->desktop_surface))
+		flags |= WESTON_DESKTOP_SHELL_WINDOW_FLAGS_MAXIMIZED;
+
+	if (shsurf->tb.shown && shsurf->tb.flags == flags &&
+	    str_equal(shsurf->tb.title, title) &&
+	    str_equal(shsurf->tb.app_id, app_id))
+		return;
+
+	if (shsurf->tb.id == 0)
+		shsurf->tb.id = ++shell->hexa.next_window_id;
+
+	if (!str_equal(shsurf->tb.title, title)) {
+		free(shsurf->tb.title);
+		shsurf->tb.title = strdup(title);
+	}
+	if (!str_equal(shsurf->tb.app_id, app_id)) {
+		free(shsurf->tb.app_id);
+		shsurf->tb.app_id = strdup(app_id);
+	}
+	shsurf->tb.flags = flags;
+	shsurf->tb.shown = true;
+
+	res = taskbar_resource(shell);
+	if (res)
+		weston_desktop_shell_send_window(res, shsurf->tb.id,
+						 title, app_id, flags);
+}
+
+static void
+taskbar_update_all(struct desktop_shell *shell)
+{
+	struct shell_surface *shsurf;
+
+	wl_list_for_each(shsurf, &shell->shsurf_list, link)
+		taskbar_update(shsurf);
+}
+
+/* Called when the panel binds: send it every window again */
+static void
+taskbar_resend_all(struct desktop_shell *shell)
+{
+	struct shell_surface *shsurf;
+
+	wl_list_for_each(shsurf, &shell->shsurf_list, link)
+		shsurf->tb.shown = false;
+	taskbar_update_all(shell);
+}
+
+static struct shell_surface *
+taskbar_find(struct desktop_shell *shell, uint32_t id)
+{
+	struct shell_surface *shsurf;
+
+	wl_list_for_each(shsurf, &shell->shsurf_list, link) {
+		if (shsurf->tb.id == id && taskbar_wants(shsurf))
+			return shsurf;
+	}
+	return NULL;
+}
+
+static void
+desktop_shell_window_activate(struct wl_client *client,
+			      struct wl_resource *resource, uint32_t id)
+{
+	struct desktop_shell *shell = wl_resource_get_user_data(resource);
+	struct shell_surface *shsurf = taskbar_find(shell, id);
+	struct weston_seat *seat;
+
+	if (!shsurf || shell->locked)
+		return;
+
+	/* Restore from the minimized layer first */
+	if (shsurf->view->layer_link.layer == &shell->minimized_layer)
+		shell_surface_update_layer(shsurf);
+
+	wl_list_for_each(seat, &shell->compositor->seat_list, link) {
+		if (weston_seat_get_keyboard(seat))
+			activate(shell, shsurf->view, seat,
+				 WESTON_ACTIVATE_FLAG_CONFIGURE);
+	}
+	taskbar_update_all(shell);
+}
+
+static void
+desktop_shell_window_minimize(struct wl_client *client,
+			      struct wl_resource *resource, uint32_t id)
+{
+	struct desktop_shell *shell = wl_resource_get_user_data(resource);
+	struct shell_surface *shsurf = taskbar_find(shell, id);
+
+	if (!shsurf || shell->locked)
+		return;
+
+	set_minimized(weston_desktop_surface_get_surface(shsurf->desktop_surface));
+}
+
+static void
+desktop_shell_window_close(struct wl_client *client,
+			   struct wl_resource *resource, uint32_t id)
+{
+	struct desktop_shell *shell = wl_resource_get_user_data(resource);
+	struct shell_surface *shsurf = taskbar_find(shell, id);
+
+	if (!shsurf || shell->locked)
+		return;
+
+	weston_desktop_surface_close(shsurf->desktop_surface);
+}
+
+static void
+desktop_shell_window_set_maximized(struct wl_client *client,
+				   struct wl_resource *resource, uint32_t id,
+				   uint32_t maximized)
+{
+	struct desktop_shell *shell = wl_resource_get_user_data(resource);
+	struct shell_surface *shsurf = taskbar_find(shell, id);
+
+	if (!shsurf || shell->locked)
+		return;
+
+	/* the client resizes and commits; the taskbar hears about it then */
+	set_maximized(shsurf, maximized != 0);
+	desktop_shell_window_activate(client, resource, id);
+}
+
+/* Start menu popup: a surface shown above windows and the panel */
+
+static int
+popup_get_label(struct weston_surface *surface, char *buf, size_t len)
+{
+	return snprintf(buf, len, "hexaOS panel popup");
+}
+
+static void
+popup_committed(struct weston_surface *es,
+		struct weston_coord_surface new_origin)
+{
+	struct desktop_shell *shell = es->committed_private;
+
+	if (shell->hexa.popup_surface != es)
+		return;
+	if (!weston_surface_has_content(es))
+		return;
+
+	if (!weston_surface_is_mapped(es)) {
+		weston_surface_map(es);
+		shell->hexa.popup_view = weston_view_create(es);
+		weston_view_move_to_layer(shell->hexa.popup_view,
+					  &shell->panel_layer.view_list);
+	}
+
+	weston_view_set_position(shell->hexa.popup_view, shell->hexa.popup_pos);
+}
+
+static void
+popup_forget(struct desktop_shell *shell)
+{
+	if (!shell->hexa.popup_surface)
+		return;
+
+	wl_list_remove(&shell->hexa.popup_destroy_listener.link);
+	if (shell->hexa.popup_view)
+		weston_view_move_to_layer(shell->hexa.popup_view, NULL);
+	shell->hexa.popup_surface = NULL;
+	shell->hexa.popup_view = NULL;
+}
+
+static void
+handle_popup_surface_destroy(struct wl_listener *listener, void *data)
+{
+	struct desktop_shell *shell =
+		container_of(listener, struct desktop_shell,
+			     hexa.popup_destroy_listener);
+
+	/* The view goes away with the surface */
+	wl_list_remove(&shell->hexa.popup_destroy_listener.link);
+	shell->hexa.popup_surface = NULL;
+	shell->hexa.popup_view = NULL;
+}
+
+static void
+desktop_shell_set_popup(struct wl_client *client,
+			struct wl_resource *resource,
+			struct wl_resource *output_resource,
+			struct wl_resource *surface_resource,
+			int32_t x, int32_t y)
+{
+	struct desktop_shell *shell = wl_resource_get_user_data(resource);
+	struct weston_surface *surface =
+		wl_resource_get_user_data(surface_resource);
+	struct weston_head *head = weston_head_from_resource(output_resource);
+	struct weston_coord_global offset;
+
+	if (surface->committed && surface->committed != popup_committed) {
+		wl_resource_post_error(surface_resource,
+				       WL_DISPLAY_ERROR_INVALID_OBJECT,
+				       "surface role already assigned");
+		return;
+	}
+
+	if (!head)
+		return;
+
+	if (shell->hexa.popup_surface != surface) {
+		popup_forget(shell);
+		shell->hexa.popup_surface = surface;
+		shell->hexa.popup_destroy_listener.notify =
+			handle_popup_surface_destroy;
+		wl_signal_add(&surface->destroy_signal,
+			      &shell->hexa.popup_destroy_listener);
+	}
+
+	surface->committed = popup_committed;
+	surface->committed_private = shell;
+	surface->output = head->output;
+	weston_surface_set_label_func(surface, popup_get_label);
+
+	offset.c = weston_coord(x, y);
+	shell->hexa.popup_pos = weston_coord_global_add(head->output->pos, offset);
+
+	if (shell->hexa.popup_view) {
+		weston_view_set_position(shell->hexa.popup_view,
+					 shell->hexa.popup_pos);
+	}
+}
+
+/* A click anywhere except on the popup or a panel closes the popup */
+static void
+popup_dismiss_unless(struct desktop_shell *shell, struct weston_view *focus)
+{
+	struct wl_resource *res = taskbar_resource(shell);
+	struct shell_output *sh_output;
+	struct weston_surface *main_surface;
+
+	if (!res || !shell->hexa.popup_view)
+		return;
+
+	if (focus) {
+		main_surface = weston_surface_get_main_surface(focus->surface);
+		if (main_surface == shell->hexa.popup_surface)
+			return;
+		wl_list_for_each(sh_output, &shell->output_list, link) {
+			if (main_surface == sh_output->panel_surface)
+				return;
+		}
+	}
+
+	weston_desktop_shell_send_popup_done(res);
+}
