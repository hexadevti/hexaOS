+static void
+context_menu_button_handler(struct widget *widget, struct input *input,
+			    uint32_t time, uint32_t button,
+			    enum wl_pointer_button_state state, void *data)
+{
+	struct context_menu *ctx = data;
+	int32_t x, y;
+
+	/* like on Windows, either button picks an entry */
+	if ((button != BTN_LEFT && button != BTN_RIGHT) ||
+	    state != WL_POINTER_BUTTON_STATE_RELEASED)
+		return;
+	input_get_position(input, &x, &y);
+	context_menu_activate(ctx, context_menu_index_at(ctx, x, y));
+}
