+static void
+taskbar_pins_save(struct desktop *desktop);
+
+static void
+taskbar_pins_changed(struct desktop *desktop)
+{
+	struct output *output;
+	struct panel_launcher *launcher, *tmp;
+
+	taskbar_pins_save(desktop);
+	wl_list_for_each(output, &desktop->outputs, link) {
+		if (!output->panel)
+			continue;
+		wl_list_for_each_safe(launcher, tmp,
+				      &output->panel->launcher_list, link)
+			panel_destroy_launcher(launcher);
+		panel_add_launchers(output->panel, desktop);
+	}
+	panels_update(desktop);
+}
+
+/* Like Windows: bring an open Task Manager back (even when minimized)
+ * instead of starting a second one */
+static void
+task_manager_show(struct desktop *desktop)
+{
+	struct task_window *win;
+
+	if (desktop->shell_version >= 2) {
+		wl_list_for_each(win, &desktop->windows, link) {
+			if (win->app_id && strcmp(win->app_id, HEXA_TASKMGR_ID) == 0) {
+				weston_desktop_shell_window_activate(desktop->shell,
+								     win->id);
+				return;
+			}
+		}
+	}
+	run_command(HEXA_TASKMGR);
+}
+
+static void
+context_menu_activate(struct context_menu *ctx, int index)
+{
+	struct desktop *desktop = ctx->desktop;
+	struct task_window *win;
+	struct ctx_entry *e;
+	uint32_t id = ctx->window_id;
+
+	if (index < 0 || index >= ctx->count || !ctx->entries[index].enabled)
+		return;
+	e = &ctx->entries[index];
+	popups_close(desktop);
+
+	switch (e->action) {
+	case CTX_LAUNCH:
+		if (e->item)
+			launch_item(e->item);
+		break;
+	case CTX_PIN:
+	case CTX_UNPIN:
+		if (e->item) {
+			e->item->pinned = e->action == CTX_PIN;
+			taskbar_pins_changed(desktop);
+		}
+		break;
+	case CTX_RESTORE:
+		wl_list_for_each(win, &desktop->windows, link) {
+			if (win->id != id)
+				continue;
+			if (win->flags & WESTON_DESKTOP_SHELL_WINDOW_FLAGS_MINIMIZED)
+				weston_desktop_shell_window_activate(desktop->shell, id);
+			else
+				weston_desktop_shell_window_set_maximized(desktop->shell,
+									  id, 0);
+			break;
+		}
+		break;
+	case CTX_MINIMIZE:
+		weston_desktop_shell_window_minimize(desktop->shell, id);
+		break;
+	case CTX_MAXIMIZE:
+		weston_desktop_shell_window_set_maximized(desktop->shell, id, 1);
+		break;
+	case CTX_CLOSE:
+		weston_desktop_shell_window_close(desktop->shell, id);
+		break;
+	case CTX_TASK_MANAGER:
+		task_manager_show(desktop);
+		break;
+	case CTX_SHOW_DESKTOP:
+		wl_list_for_each(win, &desktop->windows, link)
+			if (!(win->flags &
+			      WESTON_DESKTOP_SHELL_WINDOW_FLAGS_MINIMIZED))
+				weston_desktop_shell_window_minimize(desktop->shell,
+								     win->id);
+		break;
+	}
+}
