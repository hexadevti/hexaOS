+		cairo_line_to(cr, x + 12, cy + 4);
+		cairo_stroke(cr);
+	} else {
+		if (percent > 0) {
+			cairo_arc(cr, x + 9, cy, 5, -M_PI / 4, M_PI / 4);
+			cairo_stroke(cr);
+		}
+		if (percent > 33) {
+			cairo_arc(cr, x + 9, cy, 9, -M_PI / 4, M_PI / 4);
+			cairo_stroke(cr);
+		}
+		if (percent > 66) {
+			cairo_arc(cr, x + 9, cy, 13, -M_PI / 4, M_PI / 4);
+			cairo_stroke(cr);
+		}
+	}
+	cairo_restore(cr);
+}
+
+static void
+panel_volume_redraw_handler(struct widget *widget, void *data)
+{
+	struct panel *panel = data;
+	struct volume_state *vol = &panel->desktop->volume;
+	struct rectangle a;
+	char text[16];
+	cairo_t *cr;
+
+	widget_get_allocation(widget, &a);
+	if (a.width == 0 || !vol->available)
+		return;
+
+	cr = widget_cairo_create(panel->widget);
+	draw_button_bg(cr, &a, panel->volume_hover ? 0.10 : 0);
+	draw_speaker(cr, a.x + 8, a.y + a.height / 2.0, vol->percent,
+		     vol->muted, 0.95);
+	snprintf(text, sizeof text, "%d%%", vol->percent);
+	set_font(cr, 12, false);
+	cairo_set_source_rgba(cr, 1, 1, 1, vol->muted ? 0.5 : 0.85);
+	cairo_move_to(cr, a.x + 32, a.y + a.height / 2.0 + 4.5);
+	cairo_show_text(cr, text);
+	cairo_destroy(cr);
+}
+
+static int
+panel_volume_enter_handler(struct widget *widget, struct input *input,
+			   float x, float y, void *data)
+{
+	struct panel *panel = data;
+
+	panel->volume_hover = 1;
+	widget_schedule_redraw(widget);
+	return CURSOR_LEFT_PTR;
+}
+
+static void
+panel_volume_leave_handler(struct widget *widget, struct input *input,
+			   void *data)
+{
+	struct panel *panel = data;
+
+	panel->volume_hover = 0;
+	widget_destroy_tooltip(widget);
+	widget_schedule_redraw(widget);
+}
+
+static int
+panel_volume_motion_handler(struct widget *widget, struct input *input,
+			    uint32_t time, float x, float y, void *data)
+{
+	struct panel *panel = data;
+
+	if (panel->desktop->volume.available)
+		widget_set_tooltip(widget,
+				   "Volume: scroll to change, click to mute",
+				   x, y);
+	return CURSOR_LEFT_PTR;
+}
+
+static void
+panel_volume_button_handler(struct widget *widget, struct input *input,
+			    uint32_t time, uint32_t button,
+			    enum wl_pointer_button_state state, void *data)
+{
+	struct panel *panel = data;
+
+	widget_destroy_tooltip(widget);
+	popups_close(panel->desktop);
+	if (button == BTN_LEFT && state == WL_POINTER_BUTTON_STATE_RELEASED &&
+	    panel->desktop->volume.available)
+		volume_toggle_mute(&panel->desktop->volume);
+}
+
+static void
+panel_volume_axis_handler(struct widget *widget, struct input *input,
+			  uint32_t time, uint32_t axis, wl_fixed_t value,
+			  void *data)
+{
+	struct panel *panel = data;
+	struct volume_state *vol = &panel->desktop->volume;
+	int steps;
+
+	if (axis != WL_POINTER_AXIS_VERTICAL_SCROLL || !vol->available)
+		return;
+
+	/* one mouse wheel notch is 10 units: 5% per notch */
+	vol->scroll += wl_fixed_to_double(value);
+	steps = (int) (vol->scroll / 10);
+	if (steps == 0)
+		return;
+	vol->scroll -= steps * 10;
+	volume_set(vol, vol->percent - steps * 5);
+}
+
+/*
+ * Clock: time above, date below
+ */
+
+static int clock_timer_reset(struct panel_clock *clock);
+
+static void
+clock_func(struct toytimer *tt)
+{
+	struct panel_clock *clock = container_of(tt, struct panel_clock, timer);
+
+	widget_schedule_redraw(clock->widget);
+
+	clock_timer_reset(clock);
+}
+
+static void
+panel_clock_redraw_handler(struct widget *widget, void *data)
+{
+	struct panel_clock *clock = data;
+	struct desktop *desktop = clock->panel->desktop;
+	cairo_t *cr;
+	struct rectangle a;
+	cairo_text_extents_t ext;
+	time_t rawtime;
+	struct tm *timeinfo;
+	char time_str[64], date_str[64];
+	const char *t = time_str;
+
+	time(&rawtime);
+	timeinfo = localtime(&rawtime);
+	strftime(time_str, sizeof time_str, clock->time_format, timeinfo);
+	strftime(date_str, sizeof date_str, desktop->date_format, timeinfo);
+	if (t[0] == '0' && isdigit((unsigned char) t[1]) &&
+	    (clock->panel->clock_format == CLOCK_FORMAT_MINUTES ||
+	     clock->panel->clock_format == CLOCK_FORMAT_SECONDS))
+		t++;	/* 09:30 AM -> 9:30 AM */
+
+	widget_get_allocation(widget, &a);
+	if (a.width == 0)
+		return;
+
+	cr = widget_cairo_create(clock->panel->widget);
+	cairo_set_source_rgba(cr, 1, 1, 1, 0.92);
+
+	set_font(cr, 13, false);
+	cairo_text_extents(cr, t, &ext);
+	cairo_move_to(cr, a.x + a.width - 12 - ext.x_advance,
+		      a.y + a.height / 2.0 - 2);
+	cairo_show_text(cr, t);
+
+	set_font(cr, 12, false);
+	cairo_text_extents(cr, date_str, &ext);
+	cairo_move_to(cr, a.x + a.width - 12 - ext.x_advance,
+		      a.y + a.height / 2.0 + 13);
+	cairo_show_text(cr, date_str);
+
+	cairo_destroy(cr);
+}
+
+static int
+panel_clock_motion_handler(struct widget *widget, struct input *input,
+			   uint32_t event_time, float x, float y, void *data)
+{
+	char text[96];
+	time_t rawtime;
+
+	time(&rawtime);
+	strftime(text, sizeof text, "%A, %B %d, %Y", localtime(&rawtime));
+	widget_set_tooltip(widget, text, x, y);
+	return CURSOR_LEFT_PTR;
+}
+
+static void
+panel_clock_leave_handler(struct widget *widget, struct input *input,
+			  void *data)
+{
+	widget_destroy_tooltip(widget);
+}
+
+static void
+panel_clock_button_handler(struct widget *widget, struct input *input,
+			   uint32_t time, uint32_t button,
+			   enum wl_pointer_button_state state, void *data)
+{
+	struct panel_clock *clock = data;
+
+	widget_destroy_tooltip(widget);
+	if (state == WL_POINTER_BUTTON_STATE_PRESSED)
+		popups_close(clock->panel->desktop);
+}
+
+static int
+clock_timer_reset(struct panel_clock *clock)
+{
+	struct itimerspec its;
+	struct timespec ts;
+	struct tm *tm;
+
+	clock_gettime(CLOCK_REALTIME, &ts);
+	tm = localtime(&ts.tv_sec);
+
+	its.it_interval.tv_sec = 0;
+	its.it_interval.tv_nsec = 0;
+	its.it_value.tv_sec = clock->refresh_timer - tm->tm_sec % clock->refresh_timer;
+	its.it_value.tv_nsec = 10000000; /* 10 ms late to ensure the clock digit has actually changed */
+	timespec_add_nsec(&its.it_value, &its.it_value, -ts.tv_nsec);
+
+	toytimer_arm(&clock->timer, &its);
+	return 0;
+}
+
+static void
+panel_destroy_clock(struct panel_clock *clock)
+{
+	widget_destroy(clock->widget);
+	toytimer_fini(&clock->timer);
+	free(clock);
+}
+
+static void
+panel_add_clock(struct panel *panel)
+{
+	struct panel_clock *clock;
+
+	clock = xzalloc(sizeof *clock);
+	clock->panel = panel;
+	panel->clock = clock;
+
+	switch (panel->clock_format) {
+	case CLOCK_FORMAT_MINUTES:
+		clock->time_format = "%I:%M %p";
+		clock->refresh_timer = 60;
+		break;
+	case CLOCK_FORMAT_SECONDS:
+		clock->time_format = "%I:%M:%S %p";
+		clock->refresh_timer = 1;
+		break;
+	case CLOCK_FORMAT_MINUTES_24H:
+		clock->time_format = "%H:%M";
+		clock->refresh_timer = 60;
+		break;
+	case CLOCK_FORMAT_SECONDS_24H:
+		clock->time_format = "%H:%M:%S";
+		clock->refresh_timer = 1;
+		break;
+	case CLOCK_FORMAT_NONE:
+		assert(!"not reached");
+	}
+
+	toytimer_init(&clock->timer, CLOCK_MONOTONIC,
+		      window_get_display(panel->window), clock_func);
+	clock_timer_reset(clock);
+
+	clock->widget = widget_add_widget(panel->widget, clock);
+	widget_set_redraw_handler(clock->widget, panel_clock_redraw_handler);
+	widget_set_motion_handler(clock->widget, panel_clock_motion_handler);
+	widget_set_leave_handler(clock->widget, panel_clock_leave_handler);
+	widget_set_button_handler(clock->widget, panel_clock_button_handler);
+}
+
+/*
+ * Start menu: a popup listing every [launcher]
+ */
+
+static int
+start_menu_index_at(struct start_menu *menu, float x, float y)
+{
+	int i;
+
+	if (x < MENU_PAD || x >= menu->width - MENU_PAD ||
+	    y < MENU_HEADER_HEIGHT)
+		return -1;
+	i = (int) ((y - MENU_HEADER_HEIGHT) / MENU_ITEM_HEIGHT);
+	if (i >= wl_list_length(&menu->desktop->menu_items))
+		return -1;
+	return i;
+}
+
+static struct menu_item *
+menu_item_at_index(struct desktop *desktop, int index)
+{
+	struct menu_item *item;
+	int i = 0;
+
+	if (index < 0)
+		return NULL;
+	wl_list_for_each(item, &desktop->menu_items, link)
+		if (i++ == index)
+			return item;
+	return NULL;
+}
+
+static void
+start_menu_redraw_handler(struct widget *widget, void *data)
+{
+	struct start_menu *menu = data;
+	struct menu_item *item;
+	cairo_surface_t *surface;
+	cairo_t *cr;
+	double y;
+	int i = 0;
+
+	cr = widget_cairo_create(widget);
+	cairo_set_operator(cr, CAIRO_OPERATOR_SOURCE);
+	cairo_set_source_rgba(cr, 0, 0, 0, 0);
+	cairo_paint(cr);
+	cairo_set_operator(cr, CAIRO_OPERATOR_OVER);
+
+	path_rounded_rect(cr, 0.5, 0.5, menu->width - 1, menu->height - 1, 10);
+	cairo_set_source_rgba(cr, 0.067, 0.098, 0.165, 0.97);
+	cairo_fill_preserve(cr);
+	cairo_set_source_rgba(cr, 1, 1, 1, 0.12);
+	cairo_set_line_width(cr, 1);
+	cairo_stroke(cr);
+
+	/* header: logo and name */
+	draw_logo(cr, MENU_PAD + 20, MENU_HEADER_HEIGHT / 2.0, 11, 1.0);
+	set_font(cr, 15, true);
+	cairo_set_source_rgba(cr, 1, 1, 1, 0.95);
+	cairo_move_to(cr, MENU_PAD + 40, MENU_HEADER_HEIGHT / 2.0 + 5.5);
+	cairo_show_text(cr, "hexaOS");
+
+	cairo_set_source_rgba(cr, 1, 1, 1, 0.08);
+	cairo_rectangle(cr, MENU_PAD, MENU_HEADER_HEIGHT - 4,
+			menu->width - 2 * MENU_PAD, 1);
+	cairo_fill(cr);
+
+	set_font(cr, 14, false);
+	wl_list_for_each(item, &menu->desktop->menu_items, link) {
+		y = MENU_HEADER_HEIGHT + i * MENU_ITEM_HEIGHT;
+		if (i == menu->hover) {
+			path_rounded_rect(cr, MENU_PAD, y + 2,
+					  menu->width - 2 * MENU_PAD,
+					  MENU_ITEM_HEIGHT - 4, 6);
+			cairo_set_source_rgba(cr, 1, 1, 1, 0.10);
+			cairo_fill(cr);
+		}
+		draw_icon(cr, item->icon, MENU_PAD + 10,
+			  y + (MENU_ITEM_HEIGHT - ICON_SIZE) / 2.0,
+			  ICON_SIZE, 1.0);
+		cairo_set_source_rgba(cr, 1, 1, 1, 0.92);
+		show_text_fit(cr, item->name, MENU_PAD + 10 + ICON_SIZE + 12,
+			      y + MENU_ITEM_HEIGHT / 2.0 + 5,
+			      menu->width - 3 * MENU_PAD - ICON_SIZE - 22);
+		i++;
+	}
+
+	cairo_destroy(cr);
+	surface = window_get_surface(menu->window);
+	cairo_surface_destroy(surface);
+}
+
+static int
+start_menu_motion_handler(struct widget *widget, struct input *input,
+			  uint32_t time, float x, float y, void *data)
+{
+	struct start_menu *menu = data;
+	int i = start_menu_index_at(menu, x, y);
+
+	if (i != menu->hover) {
+		menu->hover = i;
+		widget_schedule_redraw(widget);
+	}
+	return CURSOR_LEFT_PTR;
+}
+
+static int
+start_menu_enter_handler(struct widget *widget, struct input *input,
+			 float x, float y, void *data)
+{
+	return start_menu_motion_handler(widget, input, 0, x, y, data);
+}
+
+static void
+start_menu_leave_handler(struct widget *widget, struct input *input,
+			 void *data)
+{
+	struct start_menu *menu = data;
+
+	menu->hover = -1;
+	widget_schedule_redraw(widget);
+}
+
+static void
+start_menu_activate(struct start_menu *menu, int index)
+{
+	struct menu_item *item = menu_item_at_index(menu->desktop, index);
+
+	if (!item)
+		return;
+	launch_item(item);
+	popups_close(menu->desktop);
+}
+
+static void
+start_menu_button_handler(struct widget *widget, struct input *input,
+			  uint32_t time, uint32_t button,
+			  enum wl_pointer_button_state state, void *data)
+{
+	struct start_menu *menu = data;
+	int32_t x, y;
+
+	if (button != BTN_LEFT || state != WL_POINTER_BUTTON_STATE_RELEASED)
+		return;
+	input_get_position(input, &x, &y);
+	start_menu_activate(menu, start_menu_index_at(menu, x, y));
+}
+
+static void
+start_menu_touch_down_handler(struct widget *widget, struct input *input,
+			      uint32_t serial, uint32_t time, int32_t id,
+			      float x, float y, void *data)
+{
+	struct start_menu *menu = data;
+
+	start_menu_activate(menu, start_menu_index_at(menu, x, y));
+}
+
+static void
+start_menu_open(struct panel *panel)
+{
+	struct desktop *desktop = panel->desktop;
+	struct start_menu *menu;
+	int x, y, n;
+
+	if (desktop->shell_version < 2 || !panel->owner)
+		return;
+
+	n = wl_list_length(&desktop->menu_items);
+	menu = xzalloc(sizeof *menu);
+	menu->desktop = desktop;
+	menu->hover = -1;
+	menu->width = MENU_WIDTH;
+	menu->height = MENU_HEADER_HEIGHT + n * MENU_ITEM_HEIGHT + MENU_PAD;
+
+	menu->window = window_create_custom(desktop->display);
+	menu->widget = window_add_widget(menu->window, menu);
+	window_set_title(menu->window, "Start");
+	widget_set_redraw_handler(menu->widget, start_menu_redraw_handler);
+	widget_set_enter_handler(menu->widget, start_menu_enter_handler);
+	widget_set_motion_handler(menu->widget, start_menu_motion_handler);
+	widget_set_leave_handler(menu->widget, start_menu_leave_handler);
+	widget_set_button_handler(menu->widget, start_menu_button_handler);
+	widget_set_touch_down_handler(menu->widget,
+				      start_menu_touch_down_handler);
+	window_set_buffer_scale(menu->window, panel->owner->scale);
+
+	x = MENU_PAD;
+	if (panel->panel_position == WESTON_DESKTOP_SHELL_PANEL_POSITION_TOP)
+		y = panel->height + MENU_PAD;
+	else
+		y = panel->output_height - panel->height - menu->height - MENU_PAD;
+	if (y < 0)
+		y = 0;
+
+	weston_desktop_shell_set_popup(desktop->shell, panel->owner->output,
+				       window_get_wl_surface(menu->window),
+				       x, y);
+	window_schedule_resize(menu->window, menu->width, menu->height);
+
+	desktop->menu = menu;
+	panels_update(desktop);
+}
+
+static void
+start_menu_destroy(struct desktop *desktop)
+{
+	struct start_menu *menu = desktop->menu;
+
+	if (!menu)
+		return;
+	widget_destroy(menu->widget);
+	window_destroy(menu->window);
+	free(menu);
+	desktop->menu = NULL;
+}
+
+static void
+context_menu_destroy(struct desktop *desktop);
+
+static void
+popups_close_task(struct task *task, uint32_t events)
+{
+	struct desktop *desktop =
+		container_of(task, struct desktop, popup_close_task);
+
+	desktop->popup_close_pending = false;
+	if (desktop->menu && desktop->menu->closing)
+		start_menu_destroy(desktop);
+	if (desktop->ctx && desktop->ctx->closing)
+		context_menu_destroy(desktop);
+	panels_update(desktop);
+}
+
+/* Closes the open popup (Start menu or context menu) once the current
+ * input event has been handled: it may be the popup's own event */
+static void
+popups_close(struct desktop *desktop)
+{
+	bool any = false;
+
+	if (desktop->menu && !desktop->menu->closing) {
+		desktop->menu->closing = true;
+		any = true;
+	}
+	if (desktop->ctx && !desktop->ctx->closing) {
+		desktop->ctx->closing = true;
+		any = true;
+	}
+	if (any && !desktop->popup_close_pending) {
+		desktop->popup_close_pending = true;
+		display_defer(desktop->display, &desktop->popup_close_task);
+	}
+}
+
+/* Destroys open popups right away, before opening another one: the shell
+ * shows a single popup at a time. Never call this from a popup's handler. */
+static void
+popups_destroy_now(struct desktop *desktop)
+{
+	start_menu_destroy(desktop);
+	context_menu_destroy(desktop);
+}
+
+static void
+start_menu_toggle(struct panel *panel)
+{
+	if (panel->desktop->menu) {
+		popups_close(panel->desktop);
+	} else {
+		popups_destroy_now(panel->desktop);
+		start_menu_open(panel);
+	}
+}
+
+/*
+ * Context menus: right click on the taskbar
+ */
+
+#define CTX_WIDTH		240
+#define CTX_ITEM_HEIGHT		34
+#define CTX_SEP_HEIGHT		9
+
+static struct ctx_entry *
+context_menu_add(struct context_menu *ctx, const char *label,
+		 enum ctx_action action, struct menu_item *item, bool enabled)
+{
+	struct ctx_entry *e;
+
+	if (ctx->count >= CTX_MAX_ENTRIES)
+		return NULL;
+	e = &ctx->entries[ctx->count++];
+	e->label = label;
+	e->action = action;
+	e->item = item;
+	e->enabled = enabled;
+	return e;
+}
+
+static void
+context_menu_separator(struct context_menu *ctx)
+{
+	/* the separator goes above the next entry */
+	if (ctx->count > 0 && ctx->count < CTX_MAX_ENTRIES)
+		ctx->entries[ctx->count].separator = true;
+}
+
+static int
+context_menu_index_at(struct context_menu *ctx, float x, float y)
+{
+	int i;
+
+	if (x < MENU_PAD / 2 || x >= ctx->width - MENU_PAD / 2)
+		return -1;
+	for (i = 0; i < ctx->count; i++)
+		if (y >= ctx->entries[i].y &&
+		    y < ctx->entries[i].y + ctx->entries[i].height)
+			return ctx->entries[i].enabled ? i : -1;
+	return -1;
+}
+
+/* Small line-art glyphs for the window actions, in a size x size box */
+static void
+draw_action_glyph(cairo_t *cr, enum ctx_action action, double x, double y,
+		  double size)
+{
+	double m = size * 0.25;
+
+	cairo_save(cr);
+	cairo_set_line_width(cr, 1.5);
+	cairo_set_line_cap(cr, CAIRO_LINE_CAP_ROUND);
+	switch (action) {
+	case CTX_MINIMIZE:
+		cairo_move_to(cr, x + m, y + size / 2);
+		cairo_line_to(cr, x + size - m, y + size / 2);
+		break;
+	case CTX_MAXIMIZE:
+		cairo_rectangle(cr, x + m, y + m, size - 2 * m, size - 2 * m);
+		break;
+	case CTX_RESTORE:
+		cairo_rectangle(cr, x + m, y + m + 3, size - 2 * m - 3,
+				size - 2 * m - 3);
+		cairo_move_to(cr, x + m + 3, y + m + 3);
+		cairo_line_to(cr, x + m + 3, y + m);
+		cairo_line_to(cr, x + size - m, y + m);
+		cairo_line_to(cr, x + size - m, y + size - m - 3);
+		cairo_line_to(cr, x + size - m - 3, y + size - m - 3);
+		break;
+	case CTX_CLOSE:
+		cairo_move_to(cr, x + m, y + m);
+		cairo_line_to(cr, x + size - m, y + size - m);
+		cairo_move_to(cr, x + size - m, y + m);
+		cairo_line_to(cr, x + m, y + size - m);
+		break;
+	case CTX_PIN:
+	case CTX_UNPIN:
+		/* a push pin */
+		cairo_move_to(cr, x + size / 2 - 4, y + m);
+		cairo_line_to(cr, x + size / 2 + 4, y + m);
+		cairo_move_to(cr, x + size / 2 - 2.5, y + m);
+		cairo_line_to(cr, x + size / 2 - 2.5, y + size / 2);
+		cairo_move_to(cr, x + size / 2 + 2.5, y + m);
+		cairo_line_to(cr, x + size / 2 + 2.5, y + size / 2);
+		cairo_move_to(cr, x + size / 2 - 5, y + size / 2);
+		cairo_line_to(cr, x + size / 2 + 5, y + size / 2);
+		cairo_move_to(cr, x + size / 2, y + size / 2);
+		cairo_line_to(cr, x + size / 2, y + size - m + 2);
+		if (action == CTX_UNPIN) {
+			cairo_move_to(cr, x + m - 1, y + size - m + 1);
+			cairo_line_to(cr, x + size - m + 1, y + m - 1);
+		}
+		break;
+	case CTX_TASK_MANAGER:
+		/* a pulse line */
+		cairo_move_to(cr, x + m - 2, y + size / 2);
+		cairo_line_to(cr, x + size * 0.4, y + size / 2);
+		cairo_line_to(cr, x + size * 0.5, y + m);
+		cairo_line_to(cr, x + size * 0.6, y + size - m);
+		cairo_line_to(cr, x + size * 0.68, y + size / 2);
+		cairo_line_to(cr, x + size - m + 2, y + size / 2);
+		break;
+	case CTX_SHOW_DESKTOP:
+		cairo_rectangle(cr, x + m - 1, y + m, size - 2 * m + 2,
+				size - 2 * m - 2);
+		cairo_move_to(cr, x + size / 2, y + size - m - 2);
+		cairo_line_to(cr, x + size / 2, y + size - m + 1);
+		cairo_move_to(cr, x + size / 2 - 4, y + size - m + 1);
+		cairo_line_to(cr, x + size / 2 + 4, y + size - m + 1);
+		break;
+	default:
+		break;
+	}
+	cairo_stroke(cr);
+	cairo_restore(cr);
+}
+
+static void
+context_menu_redraw_handler(struct widget *widget, void *data)
+{
+	struct context_menu *ctx = data;
+	cairo_surface_t *surface;
+	cairo_t *cr;
+	int i;
+
+	cr = widget_cairo_create(widget);
+	cairo_set_operator(cr, CAIRO_OPERATOR_SOURCE);
+	cairo_set_source_rgba(cr, 0, 0, 0, 0);
+	cairo_paint(cr);
+	cairo_set_operator(cr, CAIRO_OPERATOR_OVER);
+
+	path_rounded_rect(cr, 0.5, 0.5, ctx->width - 1, ctx->height - 1, 8);
+	cairo_set_source_rgba(cr, 0.067, 0.098, 0.165, 0.97);
+	cairo_fill_preserve(cr);
+	cairo_set_source_rgba(cr, 1, 1, 1, 0.12);
+	cairo_set_line_width(cr, 1);
+	cairo_stroke(cr);
+
+	set_font(cr, 13.5, false);
+	for (i = 0; i < ctx->count; i++) {
+		struct ctx_entry *e = &ctx->entries[i];
+		double alpha = e->enabled ? 0.92 : 0.35;
+		double gx = MENU_PAD + 8;
+		double gy = e->y + (CTX_ITEM_HEIGHT - 20) / 2.0;
+
+		if (e->separator) {
+			cairo_set_source_rgba(cr, 1, 1, 1, 0.08);
+			cairo_rectangle(cr, MENU_PAD, e->y - CTX_SEP_HEIGHT / 2.0,
+					ctx->width - 2 * MENU_PAD, 1);
+			cairo_fill(cr);
+		}
+
+		if (i == ctx->hover) {
+			path_rounded_rect(cr, MENU_PAD / 2, e->y + 1,
+					  ctx->width - MENU_PAD,
+					  e->height - 2, 5);
+			cairo_set_source_rgba(cr, 1, 1, 1, 0.10);
+			cairo_fill(cr);
+		}
+
+		if (e->action == CTX_LAUNCH && e->item) {
+			draw_icon(cr, e->item->icon, gx, gy, 20, 1.0);
+		} else {
+			cairo_set_source_rgba(cr, 1, 1, 1, alpha * 0.85);
+			draw_action_glyph(cr, e->action, gx, gy, 20);
+		}
+
+		cairo_set_source_rgba(cr, 1, 1, 1, alpha);
+		show_text_fit(cr, e->label, gx + 20 + 12,
+			      e->y + CTX_ITEM_HEIGHT / 2.0 + 4.5,
+			      ctx->width - gx - 20 - 12 - MENU_PAD);
+	}
+
+	cairo_destroy(cr);
+	surface = window_get_surface(ctx->window);
+	cairo_surface_destroy(surface);
+}
+
+static int
+context_menu_motion_handler(struct widget *widget, struct input *input,
+			    uint32_t time, float x, float y, void *data)
+{
+	struct context_menu *ctx = data;
+	int i = context_menu_index_at(ctx, x, y);
+
+	if (i != ctx->hover) {
+		ctx->hover = i;
+		widget_schedule_redraw(widget);
+	}
+	return CURSOR_LEFT_PTR;
+}
+
+static int
+context_menu_enter_handler(struct widget *widget, struct input *input,
+			   float x, float y, void *data)
+{
+	return context_menu_motion_handler(widget, input, 0, x, y, data);
+}
+
+static void
+context_menu_leave_handler(struct widget *widget, struct input *input,
+			   void *data)
+{
+	struct context_menu *ctx = data;
+
+	ctx->hover = -1;
+	widget_schedule_redraw(widget);
+}
