+	if (button == BTN_MIDDLE) {
+		weston_desktop_shell_window_close(desktop->shell, win->id);
+	} else if ((win->flags & WESTON_DESKTOP_SHELL_WINDOW_FLAGS_ACTIVATED) &&
+		   !(win->flags & WESTON_DESKTOP_SHELL_WINDOW_FLAGS_MINIMIZED)) {
+		weston_desktop_shell_window_minimize(desktop->shell, win->id);
+	} else {
+		weston_desktop_shell_window_activate(desktop->shell, win->id);
+	}
+}
