+/*
+ * hexaOS: each app opens on the screen it was last on, else on the main
+ * screen. Kept per app id in ~/.config/hexaos/window-screens, one
+ * "SCREEN<tab>APP-ID" line each (e.g. "HDMI-A-1	firefox"). A window's screen
+ * is noted when it closes and when a drag of it ends.
+ */
+struct app_screen {
+	struct wl_list link;
+	char *app_id;
+	char *output;
+};
+
+static void
+app_screens_load(struct desktop_shell *shell)
+{
+	const char *home = getenv("HOME");
+	char *line = NULL, *tab;
+	size_t size = 0;
+	ssize_t len;
+	FILE *f;
+
+	wl_list_init(&shell->hexa.app_screens);
+	if (!home || asprintf(&shell->hexa.app_screens_path,
+			      "%s/.config/hexaos/window-screens", home) < 0) {
+		shell->hexa.app_screens_path = NULL;
+		return;
+	}
+	f = fopen(shell->hexa.app_screens_path, "r");
+	if (!f)
+		return;
+	while ((len = getline(&line, &size, f)) > 0) {
+		struct app_screen *as;
+
+		if (line[len - 1] == '\n')
+			line[len - 1] = '\0';
+		tab = strchr(line, '\t');
+		if (!tab || tab == line || !tab[1])
+			continue;
+		*tab = '\0';
+		as = xzalloc(sizeof *as);
+		as->output = xstrdup(line);
+		as->app_id = xstrdup(tab + 1);
+		wl_list_insert(shell->hexa.app_screens.prev, &as->link);
+	}
+	free(line);
+	fclose(f);
+}
+
+static void
+app_screens_save(struct desktop_shell *shell)
+{
+	struct app_screen *as;
+	char *tmp;
+	FILE *f;
+
+	if (!shell->hexa.app_screens_path ||
+	    asprintf(&tmp, "%s.new", shell->hexa.app_screens_path) < 0)
+		return;
+	f = fopen(tmp, "w");
+	if (f) {
+		wl_list_for_each(as, &shell->hexa.app_screens, link)
+			fprintf(f, "%s\t%s\n", as->output, as->app_id);
+		if (fclose(f) == 0)
+			rename(tmp, shell->hexa.app_screens_path);
+		else
+			unlink(tmp);
+	}
+	free(tmp);
+}
+
+static void
+app_screens_free(struct desktop_shell *shell)
+{
+	struct app_screen *as, *next;
+
+	wl_list_for_each_safe(as, next, &shell->hexa.app_screens, link) {
+		wl_list_remove(&as->link);
+		free(as->app_id);
+		free(as->output);
+		free(as);
+	}
+	free(shell->hexa.app_screens_path);
+}
+
+/* The connected screen with this name (e.g. HDMI-A-1), else NULL */
+static struct weston_output *
+output_by_name(struct weston_compositor *compositor, const char *name)
+{
+	struct weston_output *output;
+
+	if (!name || !*name)
+		return NULL;
+	wl_list_for_each(output, &compositor->output_list, link)
+		if (!output->destroying && strcmp(output->name, name) == 0)
+			return output;
+	return NULL;
+}
+
+/* An app's own windows, not its dialogs (those follow their parent) */
+static const char *
+shell_surface_app_id(struct shell_surface *shsurf)
+{
+	const char *app_id;
+
+	if (!shsurf->desktop_surface ||
+	    weston_desktop_surface_get_parent(shsurf->desktop_surface))
+		return NULL;
+	app_id = weston_desktop_surface_get_app_id(shsurf->desktop_surface);
+	return app_id && *app_id ? app_id : NULL;
+}
+
+/* Notes the screen a window is on, for the next time its app opens */
+static void
+remember_window_screen(struct shell_surface *shsurf)
+{
+	struct desktop_shell *shell = shsurf->shell;
+	const char *app_id = shell_surface_app_id(shsurf);
+	struct weston_output *output;
+	struct app_screen *as;
+
+	if (!app_id ||
+	    !weston_surface_is_mapped(
+		    weston_desktop_surface_get_surface(shsurf->desktop_surface)))
+		return;
+	output = shell_surface_overlapping_output(shsurf);
+	if (!output)
+		output = shsurf->output;
+	if (!output || !output->name)
+		return;
+
+	wl_list_for_each(as, &shell->hexa.app_screens, link) {
+		if (strcmp(as->app_id, app_id) != 0)
+			continue;
+		if (strcmp(as->output, output->name) == 0)
+			return;
+		free(as->output);
+		as->output = xstrdup(output->name);
+		app_screens_save(shell);
+		return;
+	}
+	as = xzalloc(sizeof *as);
+	as->app_id = xstrdup(app_id);
+	as->output = xstrdup(output->name);
+	wl_list_insert(shell->hexa.app_screens.prev, &as->link);
+	app_screens_save(shell);
+}
+
+/* The screen a new window opens on: its parent's (dialogs), else the one
+ * its app was last on, else the main screen, else the first one */
+static struct weston_output *
+new_window_output(struct shell_surface *shsurf)
+{
+	struct desktop_shell *shell = shsurf->shell;
+	struct weston_compositor *compositor = shell->compositor;
+	struct weston_desktop_surface *parent =
+		weston_desktop_surface_get_parent(shsurf->desktop_surface);
+	const char *app_id = shell_surface_app_id(shsurf);
+	struct weston_output *output;
+	struct app_screen *as;
+
+	if (parent) {
+		struct shell_surface *pss =
+			weston_desktop_surface_get_user_data(parent);
+
+		if (pss && weston_surface_is_mapped(
+				weston_desktop_surface_get_surface(parent)))
+			return shell_surface_find_output(pss);
+	}
+	if (app_id) {
+		wl_list_for_each(as, &shell->hexa.app_screens, link) {
+			if (strcmp(as->app_id, app_id) != 0)
+				continue;
+			output = output_by_name(compositor, as->output);
+			if (output)
+				return output;
+			break;
+		}
+	}
+	output = output_by_name(compositor, shell->hexa.primary_output);
+	if (output)
+		return output;
+	return weston_shell_utils_get_default_output(compositor);
+}
