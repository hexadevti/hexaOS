+/*
+ * Open windows (task buttons)
+ */
+
+static int
+task_button_width(struct panel *panel)
+{
+	struct rectangle a;
+	int n = wl_list_length(&panel->desktop->windows);
+	int w;
+
+	widget_get_allocation(panel->tasks, &a);
+	if (n == 0 || a.width <= 0)
+		return 0;
+
+	w = (a.width - (n - 1) * TASK_GAP) / n;
+	if (w > TASK_MAX_WIDTH)
+		w = TASK_MAX_WIDTH;
+	return w > 1 ? w : 1;
+}
+
+static struct task_window *
+task_at_index(struct desktop *desktop, int index)
+{
+	struct task_window *win;
+	int i = 0;
+
+	if (index < 0)
+		return NULL;
+	wl_list_for_each(win, &desktop->windows, link)
+		if (i++ == index)
+			return win;
+	return NULL;
+}
+
+static int
+task_index_at(struct panel *panel, float x)
+{
+	struct rectangle a;
+	int w = task_button_width(panel);
+	int i;
+
+	if (w <= 0)
+		return -1;
+	widget_get_allocation(panel->tasks, &a);
+	if (x < a.x)
+		return -1;
+	i = (int) ((x - a.x) / (w + TASK_GAP));
+	if (x - a.x - i * (w + TASK_GAP) >= w)
+		return -1;
+	if (!task_at_index(panel->desktop, i))
+		return -1;
+	return i;
+}
+
+static void
+panel_tasks_redraw_handler(struct widget *widget, void *data)
+{
+	struct panel *panel = data;
+	struct desktop *desktop = panel->desktop;
+	struct task_window *win;
+	struct menu_item *item;
+	struct rectangle a;
+	cairo_t *cr;
+	int i = 0;
+	int w = task_button_width(panel);
+
+	if (w <= 0)
+		return;
+
+	widget_get_allocation(widget, &a);
+	cr = widget_cairo_create(panel->widget);
+
+	wl_list_for_each(win, &desktop->windows, link) {
+		bool minimized = win->flags &
+			WESTON_DESKTOP_SHELL_WINDOW_FLAGS_MINIMIZED;
+		bool active = !minimized && (win->flags &
+			WESTON_DESKTOP_SHELL_WINDOW_FLAGS_ACTIVATED);
+		double x = a.x + i * (w + TASK_GAP);
+		double y = a.y + 3, h = a.height - 6;
+		double bg = active ? 0.16 : 0.05;
+		double ix, iy = y + (h - ICON_SIZE) / 2;
+		double alpha = minimized ? 0.6 : 1.0;
+		double text_x;
+
+		if (i == panel->task_hover)
+			bg += 0.08;
+
+		path_rounded_rect(cr, x, y, w, h, 5);
+		cairo_set_source_rgba(cr, 1, 1, 1, bg);
+		cairo_fill(cr);
+
+		/* indicator line: long and cyan when active, short otherwise */
+		if (active) {
+			path_rounded_rect(cr, x + 6, y + h - 3, w - 12, 3, 1.5);
+			cairo_set_source_rgba(cr, HEXA_CYAN, 1.0);
+		} else {
+			path_rounded_rect(cr, x + w / 2.0 - 8, y + h - 3, 16, 3, 1.5);
+			cairo_set_source_rgba(cr, 1, 1, 1, 0.45);
+		}
+		cairo_fill(cr);
+
+		if (w >= ICON_SIZE + 60)
+			ix = x + 10;
+		else
+			ix = x + (w - ICON_SIZE) / 2.0;
+
+		item = item_for_app(desktop, win->app_id);
+		if (item)
+			draw_icon(cr, item->icon, ix, iy, ICON_SIZE, alpha);
+		else
+			draw_letter_icon(cr, window_label(win), ix, iy,
+					 ICON_SIZE, alpha);
+
+		if (w >= ICON_SIZE + 60) {
+			text_x = ix + ICON_SIZE + 8;
+			set_font(cr, 13, false);
+			cairo_set_source_rgba(cr, 1, 1, 1, minimized ? 0.6 : 0.95);
+			show_text_fit(cr, window_label(win), text_x,
+				      y + h / 2 + 4.5, x + w - 8 - text_x);
+		}
+		i++;
+	}
+
+	cairo_destroy(cr);
+}
