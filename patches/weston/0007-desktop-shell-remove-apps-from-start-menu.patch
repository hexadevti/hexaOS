+/* Opens ~/.config/hexaos/NAME for writing, creating the folders */
+static FILE *
+hexa_config_create(const char *name)
+{
+	char *path = hexa_config_path(name);
+	char *slash, *parent;
+	FILE *f;
+
+	if (!path)
+		return NULL;
+	/* create ~/.config and ~/.config/hexaos */
+	slash = strrchr(path, '/');
+	*slash = '\0';
+	parent = strrchr(path, '/');
+	*parent = '\0';
+	mkdir(path, 0755);
+	*parent = '/';
+	mkdir(path, 0755);
+	*slash = '/';
+
+	f = fopen(path, "w");
+	if (!f)
+		fprintf(stderr, "cannot save %s: %s\n", path, strerror(errno));
+	free(path);
+	return f;
+}
