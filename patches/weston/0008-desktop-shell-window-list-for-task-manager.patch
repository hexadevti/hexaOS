+/*
+ * The window list for the Task Manager (hexa-taskmgr, Apps tab): one line
+ * per window, "ID<tab>PID<tab>FLAGS<tab>APP-ID<tab>TITLE", in
+ * $XDG_RUNTIME_DIR/hexa-windows. PID is 0 when unknown.
+ */
+
+static void
+windows_list_put(FILE *f, const char *s)
+{
+	for (; *s; s++)
+		fputc(*s == '\t' || *s == '\n' || *s == '\r' ? ' ' : *s, f);
+}
+
+static void
+windows_list_write(void *data)
+{
+	struct desktop_shell *shell = data;
+	struct shell_surface *shsurf;
+	char *tmp;
+	FILE *f;
+
+	shell->hexa.windows_idle = NULL;
+	if (!shell->hexa.windows_path ||
+	    asprintf(&tmp, "%s.new", shell->hexa.windows_path) < 0)
+		return;
+	f = fopen(tmp, "w");
+	if (f) {
+		wl_list_for_each_reverse(shsurf, &shell->shsurf_list, link) {
+			if (!shsurf->tb.shown)
+				continue;
+			fprintf(f, "%u\t%d\t%u\t", shsurf->tb.id,
+				(int) shsurf->tb.pid, shsurf->tb.flags);
+			windows_list_put(f, shsurf->tb.app_id ? shsurf->tb.app_id : "");
+			fputc('\t', f);
+			windows_list_put(f, shsurf->tb.title ? shsurf->tb.title : "");
+			fputc('\n', f);
+		}
+		if (fclose(f) == 0)
+			rename(tmp, shell->hexa.windows_path);
+		else
+			unlink(tmp);
+	}
+	free(tmp);
+}
+
+/* Titles can change many times a second: write once things settle */
+static void
+windows_list_changed(struct desktop_shell *shell)
+{
+	if (!shell->hexa.windows_path || shell->hexa.windows_idle)
+		return;
+	shell->hexa.windows_idle = wl_event_loop_add_idle(
+		wl_display_get_event_loop(shell->compositor->wl_display),
+		windows_list_write, shell);
+}
+
+static void
+windows_list_init(struct desktop_shell *shell)
+{
+	const char *dir = getenv("XDG_RUNTIME_DIR");
+
+	if (!dir || !*dir ||
+	    asprintf(&shell->hexa.windows_path, "%s/hexa-windows", dir) < 0) {
+		shell->hexa.windows_path = NULL;
+		return;
+	}
+	windows_list_write(shell);	/* empty: no windows yet */
+}
+
+static void
+windows_list_free(struct desktop_shell *shell)
+{
+	if (shell->hexa.windows_idle)
+		wl_event_source_remove(shell->hexa.windows_idle);
+	shell->hexa.windows_idle = NULL;
+	if (shell->hexa.windows_path)
+		unlink(shell->hexa.windows_path);
+	free(shell->hexa.windows_path);
+	shell->hexa.windows_path = NULL;
+}
+
 static void
 taskbar_update_all(struct desktop_shell *shell)
 {
@@ -5816,6 +5909,7 @@ shell_destroy(struct wl_listener *listener, void *data)
 	free(shell->client);
 	free(shell->hexa.primary_output);
 	app_screens_free(shell);
+	windows_list_free(shell);
 	free(shell);
 }
 
@@ -5989,6 +6083,8 @@ wet_shell_init(struct weston_compositor *ec,
 
 	wl_list_init(&shell->seat_list);
 	wl_list_init(&shell->shsurf_list);
+	/* hexaOS: the window list for the Task Manager (needs shsurf_list) */
+	windows_list_init(shell);
 	wl_list_init(&shell->output_list);
 	wl_list_init(&shell->output_create_listener.link);
 	wl_list_init(&shell->output_move_listener.link);
