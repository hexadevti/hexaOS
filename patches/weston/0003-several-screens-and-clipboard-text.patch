+/*
+ * hexaOS: the clipboard keeps a copy of what was copied, so it can still be
+ * pasted after the program it came from closes. Weston kept the program's
+ * first MIME type only, and served nothing else; Chromium/Electron programs
+ * (VS Code...) list text/html or their own types first, so terminals (foot),
+ * which ask for plain text, got nothing to paste. Now the plain text is kept,
+ * in UTF-8 when offered, and served under the usual names for text.
+ */
+static const char *const text_types[] = {	/* best first */
+	"text/plain;charset=utf-8",
+	"UTF8_STRING",
+	"text/plain",
+	"STRING",
+	"TEXT",
+};
+
+/* Same text under these names, when the kept copy is UTF-8 */
+static const char *const utf8_aliases[] = {
+	"text/plain;charset=utf-8",
+	"UTF8_STRING",
+	"text/plain",
+};
+
+static bool
+mime_list_has(struct wl_array *types, const char *type)
+{
+	char **s;
+
+	wl_array_for_each(s, types) {
+		if (strcmp(*s, type) == 0)
+			return true;
+	}
+	return false;
+}
+
+static bool
+mime_list_add(struct wl_array *types, const char *type)
+{
+	char **s;
+
+	if (mime_list_has(types, type))
+		return true;
+	s = wl_array_add(types, sizeof *s);
+	if (s == NULL)
+		return false;
+	*s = strdup(type);
+	if (*s == NULL) {
+		types->size -= sizeof *s;
+		return false;
+	}
+	return true;
+}
+
 static void
-clipboard_source_unref(struct clipboard_source *source)
+mime_list_release(struct wl_array *types)
 {
 	char **s;
 
+	wl_array_for_each(s, types)
+		free(*s);
+	wl_array_release(types);
+}
+
+static void
+clipboard_source_unref(struct clipboard_source *source)
+{
 	source->refcount--;
 	if (source->refcount > 0)
 		return;
