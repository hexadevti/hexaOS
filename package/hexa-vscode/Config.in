config BR2_PACKAGE_HEXA_VSCODE
	bool "hexa-vscode"
	depends on BR2_x86_64
	depends on BR2_TOOLCHAIN_USES_GLIBC
	depends on BR2_PACKAGE_XORG7
	depends on BR2_PACKAGE_MESA3D_GBM
	select BR2_PACKAGE_LIBGTK3
	select BR2_PACKAGE_LIBGTK3_WAYLAND
	select BR2_PACKAGE_LIBGTK3_X11
	select BR2_PACKAGE_AT_SPI2_CORE
	select BR2_PACKAGE_LIBNSS
	select BR2_PACKAGE_CUPS
	select BR2_PACKAGE_DBUS
	select BR2_PACKAGE_EXPAT
	select BR2_PACKAGE_ALSA_LIB
	select BR2_PACKAGE_LIBXKBCOMMON
	select BR2_PACKAGE_LIBXCB
	select BR2_PACKAGE_XLIB_LIBX11
	select BR2_PACKAGE_XLIB_LIBXCOMPOSITE
	select BR2_PACKAGE_XLIB_LIBXDAMAGE
	select BR2_PACKAGE_XLIB_LIBXEXT
	select BR2_PACKAGE_XLIB_LIBXFIXES
	select BR2_PACKAGE_XLIB_LIBXRANDR
	select BR2_PACKAGE_XLIB_LIBXKBFILE
	help
	  Visual Studio Code (official Microsoft binary) in /opt/vscode.
	  The "code" command starts it in native Wayland mode.

	  https://code.visualstudio.com/
