{
    // hexaOS tasks: run with Ctrl+Shift+P > "Tasks: Run Task".
    // Everything runs inside WSL, in the project folder.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "hexaOS: Run in QEMU",
            "detail": "Boots the latest build in a QEMU window (changes are discarded)",
            "type": "process",
            "command": "wsl",
            "args": ["--cd", "${workspaceFolder}", "--", "bash", "scripts/run-qemu.sh"],
            "problemMatcher": [],
            "presentation": { "panel": "dedicated", "clear": true },
            "group": { "kind": "test", "isDefault": true }
        },
        {
            "label": "hexaOS: Run in QEMU (keep changes)",
            "detail": "Same, but keeps Wi-Fi, files and settings in disk-config.img between runs",
            "type": "process",
            "command": "wsl",
            "args": ["--cd", "${workspaceFolder}", "--", "bash", "scripts/run-qemu.sh", "--keep"],
            "problemMatcher": [],
            "presentation": { "panel": "dedicated", "clear": true }
        },
        {
            "label": "hexaOS: Build",
            "detail": "Builds the system image (~/hexaos-build/images/disk.img)",
            "type": "process",
            "command": "wsl",
            "args": ["--cd", "${workspaceFolder}", "--", "bash", "scripts/build.sh"],
            "problemMatcher": [],
            "presentation": { "panel": "dedicated", "clear": true },
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "hexaOS: Build and run",
            "detail": "Builds, then boots the new image in QEMU",
            "dependsOrder": "sequence",
            "dependsOn": ["hexaOS: Build", "hexaOS: Run in QEMU"],
            "problemMatcher": []
        },
        // hexaOS apps (Flatpak, in apps/): these run on hexaOS itself, not in WSL
        {
            "label": "App: Install",
            "detail": "Builds the app, installs it for this user and adds it to the Start menu",
            "type": "process",
            "command": "${workspaceFolder}/apps/hexa-app",
            "args": ["install", "${input:app}"],
            "problemMatcher": [],
            "presentation": { "panel": "dedicated", "clear": true }
        },
        {
            "label": "App: Install and run",
            "detail": "Same, then opens it",
            "dependsOrder": "sequence",
            "dependsOn": ["App: Install", "App: Run"],
            "problemMatcher": []
        },
        {
            "label": "App: Run",
            "detail": "Opens the installed app (its messages show here)",
            "type": "process",
            "command": "${workspaceFolder}/apps/hexa-app",
            "args": ["run", "${input:app}"],
            "problemMatcher": [],
            "presentation": { "panel": "dedicated", "clear": true }
        },
        {
            "label": "App: Bundle",
            "detail": "Makes a single .flatpak file in apps/ to install on another machine",
            "type": "process",
            "command": "${workspaceFolder}/apps/hexa-app",
            "args": ["bundle", "${input:app}"],
            "problemMatcher": [],
            "presentation": { "panel": "dedicated", "clear": true }
        },
        {
            "label": "App: Uninstall",
            "detail": "Removes the app and its Start menu entry",
            "type": "process",
            "command": "${workspaceFolder}/apps/hexa-app",
            "args": ["uninstall", "${input:app}"],
            "problemMatcher": [],
            "presentation": { "panel": "dedicated", "clear": true }
        }
    ],
    "inputs": [
        {
            // New app in apps/? Add its id here.
            "id": "app",
            "type": "pickString",
            "description": "Which app?",
            "options": ["com.hexaos.Store"],
            "default": "com.hexaos.Store"
        }
    ]
}
