+/*
+ * hexaOS window snapping, like Windows: drag a window to the top edge of a
+ * screen to maximize it there (a preview shows where), and drag a maximized
+ * window away to restore it.
+ */
+#define SNAP_DRAG_THRESHOLD 8	/* pixels before a maximized window lets go */
+#define SNAP_EDGE 2		/* pixels from the top that count as "the top" */
+
+static void
+set_maximized_on(struct shell_surface *shsurf, bool maximized,
+		 struct weston_output *output);
+
+/* The screen whose top edge the pointer is on, else NULL */
+static struct weston_output *
+pointer_snap_output(struct weston_pointer *pointer)
+{
+	struct weston_output *output;
+
+	wl_list_for_each(output, &pointer->seat->compositor->output_list, link) {
+		if (output->destroying ||
+		    !weston_output_contains_coord(output, pointer->pos))
+			continue;
+		if (pointer->pos.c.y < output->pos.c.y + SNAP_EDGE)
+			return output;
+		return NULL;
+	}
+	return NULL;
+}
+
+static int
+snap_preview_get_label(struct weston_surface *surface, char *buf, size_t len)
+{
+	return snprintf(buf, len, "hexaOS snap preview");
+}
+
+static void
+snap_preview_committed(struct weston_surface *es,
+		       struct weston_coord_surface new_origin)
+{
+}
+
+/* Shows the preview on OUTPUT's work area, or hides it (NULL) */
+static void
+snap_preview_update(struct weston_move_grab *move, struct weston_output *output)
+{
+	struct shell_surface *shsurf = move->base.shsurf;
+	struct weston_curtain_params params = {
+		.get_label = snap_preview_get_label,
+		.surface_committed = snap_preview_committed,
+		.r = 0.35, .g = 0.6, .b = 1.0, .a = 1.0,
+		.capture_input = false,
+	};
+	pixman_rectangle32_t area;
+
+	if (move->preview && move->preview_output != output) {
+		weston_shell_utils_curtain_destroy(move->preview);
+		move->preview = NULL;
+		move->preview_output = NULL;
+	}
+	if (!output || move->preview || !shsurf || !shsurf->desktop_surface ||
+	    !weston_view_is_mapped(shsurf->view))
+		return;
+
+	get_output_work_area(shsurf->shell, output, &area);
+	if (area.width == 0 || area.height == 0)
+		return;
+	params.pos.c = weston_coord(area.x, area.y);
+	params.width = area.width;
+	params.height = area.height;
+	move->preview = weston_shell_utils_curtain_create(shsurf->shell->compositor,
+							 &params);
+	if (!move->preview)
+		return;
+	move->preview_output = output;
+	weston_view_set_alpha(move->preview->view, 0.3);
+	weston_view_set_output(move->preview->view, output);
+	/* just behind the window being dragged */
+	weston_view_move_to_layer(move->preview->view, &shsurf->view->layer_link);
+}
+
+/* Dragging a maximized window: restore it, remembering where it was grabbed
+ * (see unsnap_place) */
+static void
+unsnap_start(struct shell_surface *shsurf, struct weston_move_grab *move,
+	     struct weston_pointer *pointer)
+{
+	struct weston_surface *surface =
+		weston_desktop_surface_get_surface(shsurf->desktop_surface);
+	struct weston_geometry geo;
+	struct weston_coord_global pos;
+
+	geo = weston_desktop_surface_get_geometry(shsurf->desktop_surface);
+	if (geo.width <= 0 || geo.height <= 0) {
+		geo.x = 0;
+		geo.y = 0;
+		geo.width = surface->width;
+		geo.height = surface->height;
+	}
+	pos = weston_view_get_pos_offset_global(shsurf->view);
+
+	shsurf->unsnap.fx = geo.width > 0 ?
+		(move->start.c.x - (pos.c.x + geo.x)) / geo.width : 0.5;
+	shsurf->unsnap.fx = MAX(0.0, MIN(1.0, shsurf->unsnap.fx));
+	shsurf->unsnap.dy = MAX(0.0, move->start.c.y - (pos.c.y + geo.y));
+	shsurf->unsnap.grab = move;
+	shsurf->unsnap.pointer = pointer->pos;
+	shsurf->unsnap.pending = true;
+
+	set_maximized_on(shsurf, false, NULL);
+}
+
+/* The restored size arrived: put the window under the pointer, held at the
+ * same place of its title bar, and let the drag go on from there */
+static void
+unsnap_place(struct shell_surface *shsurf)
+{
+	struct weston_surface *surface =
+		weston_desktop_surface_get_surface(shsurf->desktop_surface);
+	struct weston_move_grab *move = shsurf->unsnap.grab;
+	struct weston_geometry geo;
+	struct weston_coord_global ptr, pos;
+	double dy;
+
+	shsurf->unsnap.pending = false;
+	shsurf->unsnap.grab = NULL;
+
+	geo = weston_desktop_surface_get_geometry(shsurf->desktop_surface);
+	if (geo.width <= 0 || geo.height <= 0) {
+		geo.x = 0;
+		geo.y = 0;
+		geo.width = surface->width;
+		geo.height = surface->height;
+	}
+	ptr = move ? move->base.grab.pointer->pos : shsurf->unsnap.pointer;
+	dy = MIN(shsurf->unsnap.dy, MAX(0, geo.height - 1));
+
+	pos.c = weston_coord(ptr.c.x - shsurf->unsnap.fx * geo.width - geo.x,
+			     ptr.c.y - dy - geo.y);
+	weston_view_set_position(shsurf->view, pos);
+	if (move)
+		move->delta = weston_coord_global_sub(pos, ptr);
+}
+
