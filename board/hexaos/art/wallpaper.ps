%!PS
% Papel de parede 1920x1080 do hexaOS
(common.ps) run
<< /PageSize [1920 1080] >> setpagedevice

% fundo em degrade diagonal
<< /ShadingType 2 /ColorSpace /DeviceRGB
   /Coords [0 0 1920 1080]
   /Function << /FunctionType 2 /Domain [0 1]
                /C0 [0.030 0.050 0.100] /C1 [0.060 0.140 0.240] /N 1 >>
   /Extend [true true] >> shfill

% grade de hexagonos bem discreta
0.085 0.150 0.230 setrgbcolor 1.5 setlinewidth
1920 1080 46 hexgrid

% logo + nome
960 600 150 logo
1 1 1 setrgbcolor (hexaOS) 960 330 96 centertext
0.55 0.70 0.80 setrgbcolor (leve  \267  livre  \267  seu) 960 275 30 centertext

showpage
