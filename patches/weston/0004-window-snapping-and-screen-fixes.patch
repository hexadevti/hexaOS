+	snap_preview_update(move, pointer_snap_output(pointer));
+}
+
+static void
+move_grab_end(struct weston_move_grab *move)
+{
+	struct shell_surface *shsurf = move->base.shsurf;
+
+	snap_preview_update(move, NULL);
+	if (shsurf && shsurf->unsnap.grab == move) {
+		/* the drag is over, the restored window goes under the
+		 * pointer where it is now */
+		shsurf->unsnap.grab = NULL;
+		shsurf->unsnap.pointer = move->base.grab.pointer->pos;
+	}
+	shell_grab_end(&move->base);
+	free(move);
 }
 
