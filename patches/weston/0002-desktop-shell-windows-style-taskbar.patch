+/*
+ * Volume (PipeWire, through wpctl)
+ */
+
+static void
+volume_reader_finish(struct volume_state *vol)
+{
+	struct desktop *desktop = vol->desktop;
+	bool available = vol->available, muted = vol->muted;
+	int percent = vol->percent;
+	double v;
+
+	display_unwatch_fd(desktop->display, vol->reader_fd);
+	close(vol->reader_fd);
+	vol->reader_fd = -1;
+	vol->reader_pid = 0;
+
+	vol->reader_buf[vol->reader_len] = '\0';
+	if (sscanf(vol->reader_buf, "Volume: %lf", &v) == 1) {
+		vol->available = true;
+		vol->percent = (int) (v * 100 + 0.5);
+		vol->muted = strstr(vol->reader_buf, "MUTED") != NULL;
+	} else {
+		vol->available = false;
+	}
+
+	if (available != vol->available || muted != vol->muted ||
+	    percent != vol->percent)
+		panels_update(desktop);
+}
+
+static void
+volume_reader_func(struct task *task, uint32_t events)
+{
+	struct volume_state *vol =
+		container_of(task, struct volume_state, reader_task);
+	size_t room = sizeof vol->reader_buf - 1 - vol->reader_len;
+	ssize_t n;
+
+	n = read(vol->reader_fd, vol->reader_buf + vol->reader_len, room);
+	if (n > 0) {
+		vol->reader_len += n;
+		if (vol->reader_len < sizeof vol->reader_buf - 1)
+			return;		/* wait for more, or end of file */
+	} else if (n < 0 && (errno == EAGAIN || errno == EINTR)) {
+		return;
+	}
+	volume_reader_finish(vol);
+}
+
+/* Starts reading the volume in the background */
+static void
+volume_read(struct volume_state *vol)
+{
+	int fds[2];
+	pid_t pid;
+
+	if (vol->reader_pid > 0) {
+		/* still running: give up on it after a few ticks */
+		if (++vol->reader_ticks >= 3)
+			kill(vol->reader_pid, SIGKILL);
+		return;
+	}
+
+	if (pipe2(fds, O_CLOEXEC) < 0)
+		return;
+
+	pid = fork();
+	if (pid < 0) {
+		close(fds[0]);
+		close(fds[1]);
+		return;
+	}
+	if (pid == 0) {
+		dup2(fds[1], STDOUT_FILENO);
+		execl("/bin/sh", "sh", "-c",
+		      "exec wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null",
+		      (char *) NULL);
+		_exit(127);
+	}
+
+	close(fds[1]);
+	fcntl(fds[0], F_SETFL, fcntl(fds[0], F_GETFL) | O_NONBLOCK);
+	vol->reader_pid = pid;
+	vol->reader_fd = fds[0];
+	vol->reader_ticks = 0;
+	vol->reader_len = 0;
+	vol->reader_task.run = volume_reader_func;
+	display_watch_fd(vol->desktop->display, fds[0],
+			 EPOLLIN | EPOLLHUP | EPOLLERR, &vol->reader_task);
 }
 
