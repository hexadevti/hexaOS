config BR2_PACKAGE_HEXA_WINE
	bool "hexa-wine (64-bit Wine with WoW64)"
	depends on BR2_x86_64
	depends on !BR2_STATIC_LIBS
	depends on BR2_TOOLCHAIN_HAS_THREADS_NPTL
	depends on BR2_PACKAGE_HAS_UDEV
	select BR2_PACKAGE_WAYLAND
	select BR2_PACKAGE_LIBXKBCOMMON
	select BR2_PACKAGE_LIBXML2 # libxkbregistry
	select BR2_PACKAGE_FREETYPE
	select BR2_PACKAGE_FONTCONFIG
	select BR2_PACKAGE_ALSA_LIB
	select BR2_PACKAGE_ALSA_LIB_SEQ
	select BR2_PACKAGE_ALSA_LIB_RAWMIDI
	select BR2_PACKAGE_GNUTLS
	select BR2_PACKAGE_PULSEAUDIO # libpulse (server: pipewire-pulse)
	select BR2_PACKAGE_VULKAN_LOADER
	depends on BR2_PACKAGE_MESA3D_OPENGL_EGL # OpenGL via EGL on Wayland
	help
	  Wine for x86_64 in the new WoW64 mode: runs 64 and 32-bit
	  Windows programs without 32-bit Linux libraries.
	  Uses Wine's Wayland driver (no X11 needed).

	  Requires the mingw compilers on the build machine:
	    sudo apt install gcc-mingw-w64

	  https://www.winehq.org
