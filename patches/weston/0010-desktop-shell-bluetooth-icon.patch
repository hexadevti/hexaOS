 /*
+ * Bluetooth (BlueZ, through hexa-bluetooth)
+ */
+
+static int
+bluetooth_connected_count(struct bluetooth_state *bt)
+{
+	int i, n = 0;
+
+	for (i = 0; i < bt->info.n_devices; i++)
+		if (bt->info.devices[i].connected)
+			n++;
+	return n;
+}
+
+/* "powered 1", then "dev CONNECTED ADDRESS NAME" lines; no output at all
+ * when there is no adapter */
+static void
+bluetooth_parse(struct bluetooth_state *bt, struct bt_info *info)
+{
+	char *line, *save = NULL;
+
+	memset(info, 0, sizeof *info);
+	for (line = strtok_r(bt->reader_buf, "\n", &save); line;
+	     line = strtok_r(NULL, "\n", &save)) {
+		char addr[18];
+		int v, len = strlen(line);
+
+		if (sscanf(line, "powered %d", &v) == 1) {
+			info->available = true;
+			info->powered = v != 0;
+		} else if (info->n_devices < BT_MAX_DEVICES &&
+			   sscanf(line, "dev %d %17s %n", &v, addr, &len) == 2) {
+			struct bt_device *d = &info->devices[info->n_devices++];
+
+			snprintf(d->addr, sizeof d->addr, "%s", addr);
+			snprintf(d->name, sizeof d->name, "%s",
+				 line[len] ? line + len : addr);
+			d->connected = v != 0;
+		}
+	}
+}
+
+static void
+bluetooth_reader_finish(struct bluetooth_state *bt)
+{
+	struct desktop *desktop = bt->desktop;
+	struct bt_info info;
+
+	display_unwatch_fd(desktop->display, bt->reader_fd);
+	close(bt->reader_fd);
+	bt->reader_fd = -1;
+	bt->reader_pid = 0;
+
+	bt->reader_buf[bt->reader_len] = '\0';
+	bluetooth_parse(bt, &info);
+	if (memcmp(&info, &bt->info, sizeof info) != 0) {
+		bt->info = info;
+		panels_update(desktop);
+	}
+}
+
+static void
+bluetooth_reader_func(struct task *task, uint32_t events)
+{
+	struct bluetooth_state *bt =
+		container_of(task, struct bluetooth_state, reader_task);
+	size_t room = sizeof bt->reader_buf - 1 - bt->reader_len;
+	ssize_t n;
+
+	n = read(bt->reader_fd, bt->reader_buf + bt->reader_len, room);
+	if (n > 0) {
+		bt->reader_len += n;
+		if (bt->reader_len < sizeof bt->reader_buf - 1)
+			return;		/* wait for more, or end of file */
+	} else if (n < 0 && (errno == EAGAIN || errno == EINTR)) {
+		return;
+	}
+	bluetooth_reader_finish(bt);
+}
+
+/* Starts reading the Bluetooth state in the background */
+static void
+bluetooth_read(struct bluetooth_state *bt)
+{
+	int fds[2];
+	pid_t pid;
+
+	if (bt->reader_pid > 0) {
+		/* still running: give up on it after a few ticks */
+		if (++bt->reader_ticks >= 3)
+			kill(bt->reader_pid, SIGKILL);
+		return;
+	}
+
+	if (pipe2(fds, O_CLOEXEC) < 0)
+		return;
+
+	pid = fork();
+	if (pid < 0) {
+		close(fds[0]);
+		close(fds[1]);
+		return;
+	}
+	if (pid == 0) {
+		dup2(fds[1], STDOUT_FILENO);
+		execl(HEXA_BLUETOOTH, "hexa-bluetooth", "status", (char *) NULL);
+		_exit(127);
+	}
+
+	close(fds[1]);
+	fcntl(fds[0], F_SETFL, fcntl(fds[0], F_GETFL) | O_NONBLOCK);
+	bt->reader_pid = pid;
+	bt->reader_fd = fds[0];
+	bt->reader_ticks = 0;
+	bt->reader_len = 0;
+	bt->reader_task.run = bluetooth_reader_func;
+	display_watch_fd(bt->desktop->display, fds[0],
+			 EPOLLIN | EPOLLHUP | EPOLLERR, &bt->reader_task);
+}
+
+static void
+bluetooth_timer_func(struct toytimer *tt)
+{
+	bluetooth_read(container_of(tt, struct bluetooth_state, timer));
+}
+
+/* Reads the state again in SECONDS (after a change), then as usual */
+static void
+bluetooth_poll_in(struct bluetooth_state *bt, int seconds)
+{
+	struct itimerspec its = {
+		.it_interval = { .tv_sec = BT_POLL_SECONDS },
+		.it_value = { .tv_sec = seconds },
+	};
+
+	toytimer_arm(&bt->timer, &its);
+}
+
+static void
+bluetooth_set_power(struct bluetooth_state *bt, bool on)
+{
+	run_command(on ? HEXA_BLUETOOTH " power on" :
+			 HEXA_BLUETOOTH " power off");
+	/* show it right away; the next reading confirms it */
+	bt->info.powered = on;
+	if (!on)
+		bt->info.n_devices = 0;
+	panels_update(bt->desktop);
+	bluetooth_poll_in(bt, 2);
+}
+
+/* ADDR comes from hexa-bluetooth, but check it before it goes to a shell */
+static bool
+bluetooth_addr_ok(const char *addr)
+{
+	int i;
+
+	if (strlen(addr) != 17)
+		return false;
+	for (i = 0; i < 17; i++)
+		if (i % 3 == 2 ? addr[i] != ':' : !isxdigit((unsigned char) addr[i]))
+			return false;
+	return true;
+}
+
+static void
+bluetooth_toggle_device(struct bluetooth_state *bt, const char *addr,
+			bool connected)
+{
+	char cmd[96];
+
+	if (!bluetooth_addr_ok(addr))
+		return;
+	snprintf(cmd, sizeof cmd, HEXA_BLUETOOTH " %s %s",
+		 connected ? "disconnect" : "connect", addr);
+	run_command(cmd);
+	bluetooth_poll_in(bt, 3);
+}
+
+/* The Bluetooth rune, S tall from the center, as a path */
+static void
+draw_bluetooth_rune(cairo_t *cr, double cx, double cy, double s)
+{
+	double w = s * 0.5;
+
+	cairo_move_to(cr, cx - w, cy - w);
+	cairo_line_to(cr, cx + w, cy + w);
+	cairo_line_to(cr, cx, cy + s);
+	cairo_line_to(cr, cx, cy - s);
+	cairo_line_to(cr, cx + w, cy - w);
+	cairo_line_to(cr, cx - w, cy + w);
+}
+
+static void
+panel_bluetooth_redraw_handler(struct widget *widget, void *data)
+{
+	struct panel *panel = data;
+	struct bluetooth_state *bt = &panel->desktop->bluetooth;
+	struct rectangle a;
+	double cx, cy;
+	cairo_t *cr;
+
+	widget_get_allocation(widget, &a);
+	if (a.width == 0 || !bt->info.available)
+		return;
+
+	cr = widget_cairo_create(panel->widget);
+	draw_button_bg(cr, &a, panel->bluetooth_hover ? 0.10 : 0);
+	cx = a.x + a.width / 2.0;
+	cy = a.y + a.height / 2.0;
+	cairo_set_line_width(cr, 1.6);
+	cairo_set_line_cap(cr, CAIRO_LINE_CAP_ROUND);
+	cairo_set_line_join(cr, CAIRO_LINE_JOIN_ROUND);
+	/* dimmed when off */
+	cairo_set_source_rgba(cr, 1, 1, 1, bt->info.powered ? 0.95 : 0.38);
+	draw_bluetooth_rune(cr, cx - 1, cy, 8);
+	cairo_stroke(cr);
+	/* a dot when a device is connected */
+	if (bluetooth_connected_count(bt) > 0) {
+		cairo_set_source_rgb(cr, HEXA_CYAN);
+		cairo_arc(cr, cx + 7, cy + 6, 2.5, 0, 2 * M_PI);
+		cairo_fill(cr);
+	}
+	cairo_destroy(cr);
+}
+
+static int
+panel_bluetooth_enter_handler(struct widget *widget, struct input *input,
+			      float x, float y, void *data)
+{
+	struct panel *panel = data;
+
+	panel->bluetooth_hover = 1;
+	widget_schedule_redraw(widget);
+	return CURSOR_LEFT_PTR;
+}
+
+static void
+panel_bluetooth_leave_handler(struct widget *widget, struct input *input,
+			      void *data)
+{
+	struct panel *panel = data;
+
+	panel->bluetooth_hover = 0;
+	widget_destroy_tooltip(widget);
+	widget_schedule_redraw(widget);
+}
+
+static int
+panel_bluetooth_motion_handler(struct widget *widget, struct input *input,
+			       uint32_t time, float x, float y, void *data)
+{
+	struct panel *panel = data;
+	struct bluetooth_state *bt = &panel->desktop->bluetooth;
+	int i, n = bluetooth_connected_count(bt);
+
+	if (!bt->info.available)
+		return CURSOR_LEFT_PTR;
+	if (!bt->info.powered) {
+		snprintf(bt->tooltip, sizeof bt->tooltip, "Bluetooth: off");
+	} else if (n == 0) {
+		snprintf(bt->tooltip, sizeof bt->tooltip,
+			 "Bluetooth: on, nothing connected");
+	} else {
+		for (i = 0; !bt->info.devices[i].connected; i++)
+			;
+		if (n == 1)
+			snprintf(bt->tooltip, sizeof bt->tooltip,
+				 "Bluetooth: %s", bt->info.devices[i].name);
+		else
+			snprintf(bt->tooltip, sizeof bt->tooltip,
+				 "Bluetooth: %s and %d more",
+				 bt->info.devices[i].name, n - 1);
+	}
+	widget_set_tooltip(widget, bt->tooltip, x, y);
+	return CURSOR_LEFT_PTR;
+}
+
+static void
+panel_bluetooth_button_handler(struct widget *widget, struct input *input,
+			       uint32_t time, uint32_t button,
+			       enum wl_pointer_button_state state, void *data)
+{
+	struct panel *panel = data;
+	struct rectangle a;
+
+	widget_destroy_tooltip(widget);
+	popups_close(panel->desktop);
+	if ((button != BTN_LEFT && button != BTN_RIGHT) ||
+	    state != WL_POINTER_BUTTON_STATE_RELEASED ||
+	    !panel->desktop->bluetooth.info.available)
+		return;
+	widget_get_allocation(widget, &a);
+	context_menu_open(panel, CTX_FOR_BLUETOOTH, a.x, NULL, NULL);
+}
+
+static void
+panel_bluetooth_touch_down_handler(struct widget *widget, struct input *input,
+				   uint32_t serial, uint32_t time, int32_t id,
+				   float x, float y, void *data)
+{
+	struct panel *panel = data;
+	struct rectangle a;
+
+	if (!panel->desktop->bluetooth.info.available)
+		return;
+	widget_get_allocation(widget, &a);
+	context_menu_open(panel, CTX_FOR_BLUETOOTH, a.x, NULL, NULL);
+}
