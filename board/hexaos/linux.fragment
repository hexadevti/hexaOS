# Ajustes do hexaOS sobre o x86_64_defconfig do kernel
CONFIG_LOCALVERSION="-hexaos"
CONFIG_DEFAULT_HOSTNAME="hexaos"

# Boot UEFI
CONFIG_EFI=y
CONFIG_EFI_STUB=y

# /dev automatico (exigido pelo eudev)
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Tela grafica via framebuffer do UEFI (funciona em QEMU e no notebook)
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_DRM_PANIC=y

# Dispositivos virtuais do QEMU
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM_VIRTIO=y

# Sistema de arquivos raiz
CONFIG_EXT4_FS=y

# ===== Notebook: Samsung Galaxy Book4 Pro (Intel Core Ultra / Meteor Lake) =====

# SSD NVMe
CONFIG_BLK_DEV_NVME=y

# Video Intel Arc (i915; firmware em /lib/firmware/i915)
CONFIG_DRM_I915=m
CONFIG_BACKLIGHT_CLASS_DEVICE=y

# Wi-Fi Intel AX211 (iwlwifi; firmware iwlwifi-so-a0-gf-a0)
CONFIG_RFKILL=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
CONFIG_IWLMLD=m

# Touchpad e teclado internos (I2C-HID via controlador LPSS da Intel)
CONFIG_MFD_INTEL_LPSS_PCI=y
CONFIG_MFD_INTEL_LPSS_ACPI=y
CONFIG_INTEL_IDMA64=y
CONFIG_PINCTRL=y
CONFIG_GPIOLIB=y
CONFIG_PINCTRL_METEORLAKE=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_I2C_DESIGNWARE_PCI=y
CONFIG_I2C_HID_ACPI=m
CONFIG_HID_MULTITOUCH=m

# Recursos especificos da Samsung (luz do teclado, modos de desempenho)
CONFIG_SAMSUNG_GALAXYBOOK=m

# Audio: DSP Intel (SOF) + codec Realtek + microfones digitais
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_GENERIC=m
CONFIG_SND_HDA_CODEC_REALTEK=m
CONFIG_SND_HDA_CODEC_HDMI=m
CONFIG_SND_HDA_CODEC_HDMI_INTEL=m
CONFIG_SND_SOC=m
CONFIG_SND_SOC_SOF_TOPLEVEL=y
CONFIG_SND_SOC_SOF_PCI=m
CONFIG_SND_SOC_SOF_INTEL_TOPLEVEL=y
CONFIG_SND_SOC_SOF_METEORLAKE=m
CONFIG_SND_SOC_SOF_HDA_LINK=y
CONFIG_SND_SOC_SOF_HDA_AUDIO_CODEC=y
CONFIG_SND_SOC_INTEL_SST_TOPLEVEL=y
CONFIG_SND_SOC_INTEL_MACH=y
CONFIG_SND_SOC_INTEL_SKL_HDA_DSP_GENERIC_MACH=m
CONFIG_SND_SOC_DMIC=m

# Wine: permitir programas Windows de 16/32 bits e chamadas de sistema emuladas
CONFIG_IA32_EMULATION=y
CONFIG_MODIFY_LDT_SYSCALL=y
