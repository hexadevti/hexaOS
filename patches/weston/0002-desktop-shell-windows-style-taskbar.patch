+static void
+context_menu_touch_down_handler(struct widget *widget, struct input *input,
+				uint32_t serial, uint32_t time, int32_t id,
+				float x, float y, void *data)
+{
+	struct context_menu *ctx = data;
+
+	context_menu_activate(ctx, context_menu_index_at(ctx, x, y));
+}
