+/* Shows text with its baseline at y, cut with an ellipsis to fit max_w */
+static void
+show_text_fit(cairo_t *cr, const char *text, double x, double y, double max_w)
+{
+	static const char ellipsis[] = "\xe2\x80\xa6";
+	cairo_text_extents_t ext;
+	char buf[512];
+	size_t len;
+
+	if (max_w <= 0)
+		return;
+
+	cairo_text_extents(cr, text, &ext);
+	cairo_move_to(cr, x, y);
+	if (ext.x_advance <= max_w) {
+		cairo_show_text(cr, text);
+		return;
+	}
+
+	len = strlen(text);
+	if (len > sizeof buf - sizeof ellipsis)
+		len = sizeof buf - sizeof ellipsis;
+	buf[0] = '\0';
+	while (len > 0) {
+		/* step back one whole UTF-8 character */
+		len--;
+		while (len > 0 && ((unsigned char) text[len] & 0xc0) == 0x80)
+			len--;
+		memcpy(buf, text, len);
+		memcpy(buf + len, ellipsis, sizeof ellipsis);
+		cairo_text_extents(cr, buf, &ext);
+		if (ext.x_advance <= max_w)
+			break;
+	}
+	if (len > 0)
+		cairo_show_text(cr, buf);
+}
+
+/* Draws icon scaled into a size x size square at x, y */
+static void
+draw_icon(cairo_t *cr, cairo_surface_t *icon, double x, double y, double size,
+	  double alpha)
+{
+	double w = cairo_image_surface_get_width(icon);
+	double h = cairo_image_surface_get_height(icon);
+	double s = size / (w > h ? w : h);
+
+	cairo_save(cr);
+	cairo_translate(cr, x + (size - w * s) / 2, y + (size - h * s) / 2);
+	cairo_scale(cr, s, s);
+	cairo_set_source_surface(cr, icon, 0, 0);
+	cairo_pattern_set_filter(cairo_get_source(cr), CAIRO_FILTER_GOOD);
+	cairo_paint_with_alpha(cr, alpha);
+	cairo_restore(cr);
+}
+
+/* Icon for windows without one: a rounded square with the first letter */
+static void
+draw_letter_icon(cairo_t *cr, const char *name, double x, double y,
+		 double size, double alpha)
+{
+	cairo_text_extents_t ext;
+	char letter[8] = "?";
+	size_t n = 1;
+
+	if (name && name[0]) {
+		while (name[n] && ((unsigned char) name[n] & 0xc0) == 0x80 &&
+		       n < sizeof letter - 1)
+			n++;
+		memcpy(letter, name, n);
+		letter[n] = '\0';
+		if (n == 1)
+			letter[0] = toupper((unsigned char) letter[0]);
+	}
+
+	cairo_save(cr);
+	path_rounded_rect(cr, x + 1, y + 1, size - 2, size - 2, 5);
+	cairo_set_source_rgba(cr, HEXA_BLUE, alpha);
+	cairo_fill(cr);
+	set_font(cr, size * 0.55, true);
+	cairo_text_extents(cr, letter, &ext);
+	cairo_move_to(cr, x + size / 2 - ext.width / 2 - ext.x_bearing,
+		      y + size / 2 - ext.height / 2 - ext.y_bearing);
+	cairo_set_source_rgba(cr, 1, 1, 1, alpha);
+	cairo_show_text(cr, letter);
+	cairo_restore(cr);
+}
+
+static cairo_surface_t *
+load_icon_or_fallback(const char *icon)
+{
+	cairo_surface_t *surface = cairo_image_surface_create_from_png(icon);
+	cairo_status_t status;
+	cairo_t *cr;
+
+	status = cairo_surface_status(surface);
+	if (status == CAIRO_STATUS_SUCCESS)
+		return surface;
+
+	cairo_surface_destroy(surface);
+	fprintf(stderr, "ERROR loading icon from file '%s', error: '%s'\n",
+		icon, cairo_status_to_string(status));
+
+	/* draw fallback icon */
+	surface = cairo_image_surface_create(CAIRO_FORMAT_ARGB32,
+					     20, 20);
+	cr = cairo_create(surface);
+
+	cairo_set_source_rgba(cr, 0.8, 0.8, 0.8, 1);
+	cairo_paint(cr);
+
+	cairo_set_source_rgba(cr, 0, 0, 0, 1);
+	cairo_set_line_cap(cr, CAIRO_LINE_CAP_ROUND);
+	cairo_rectangle(cr, 0, 0, 20, 20);
+	cairo_move_to(cr, 4, 4);
+	cairo_line_to(cr, 16, 16);
+	cairo_move_to(cr, 4, 16);
+	cairo_line_to(cr, 16, 4);
+	cairo_stroke(cr);
+
+	cairo_destroy(cr);
+
+	return surface;
+}
