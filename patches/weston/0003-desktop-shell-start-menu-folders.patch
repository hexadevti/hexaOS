+/* Most rows any view has (main list or a folder): the menu keeps one size */
+static int
+start_menu_max_rows(struct desktop *desktop)
+{
+	struct menu_item *item, *other;
+	int top = 0, in_folder, max;
+	bool first;
+
+	wl_list_for_each(item, &desktop->menu_items, link) {
+		if (!item->folder) {
+			top++;
+			continue;
+		}
+		first = true;
+		wl_list_for_each(other, &desktop->menu_items, link) {
+			if (other == item)
+				break;
+			if (other->folder && strcmp(other->folder, item->folder) == 0)
+				first = false;
+		}
+		if (first)
+			top++;
+	}
+	max = top;
+	wl_list_for_each(item, &desktop->menu_items, link) {
+		if (!item->folder)
+			continue;
+		in_folder = 1;	/* the Back row */
+		wl_list_for_each(other, &desktop->menu_items, link)
+			if (other->folder && strcmp(other->folder, item->folder) == 0)
+				in_folder++;
+		if (in_folder > max)
+			max = in_folder;
+	}
+	return max;
+}
