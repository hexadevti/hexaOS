# hexaOS: line editing in the terminal (bash, python...). Personal changes
# go in ~/.inputrc (start it with "$include /etc/inputrc").

set input-meta on
set output-meta on
set convert-meta off
set bell-style none
set enable-bracketed-paste on

# Tab completion: ignore upper/lower case, list choices on the first Tab,
# color the list like ls does
set completion-ignore-case on
set completion-map-case on
set show-all-if-ambiguous on
set colored-stats on
set colored-completion-prefix on
set mark-symlinked-directories on

# Up / Down: previous commands that start with what is already typed
"\e[A": history-search-backward
"\e[B": history-search-forward
"\eOA": history-search-backward
"\eOB": history-search-forward

# Ctrl+Left / Ctrl+Right: move one word
"\e[1;5D": backward-word
"\e[1;5C": forward-word
# Ctrl+Backspace / Ctrl+Delete: delete one word
"\C-h": backward-kill-word
"\e[3;5~": kill-word

# Home, End, Delete
"\e[H": beginning-of-line
"\e[F": end-of-line
"\eOH": beginning-of-line
"\eOF": end-of-line
"\e[1~": beginning-of-line
"\e[4~": end-of-line
"\e[3~": delete-char
