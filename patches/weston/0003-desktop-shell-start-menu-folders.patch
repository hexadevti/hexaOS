+/* Folder icon: a tab and a body in the hexaOS blue */
+static void
+draw_folder_icon(cairo_t *cr, double x, double y, double size)
+{
+	cairo_save(cr);
+	path_rounded_rect(cr, x + 1, y + size * 0.15, size * 0.45, size * 0.3, 2);
+	cairo_set_source_rgba(cr, HEXA_BLUE, 1.0);
+	cairo_fill(cr);
+	path_rounded_rect(cr, x + 1, y + size * 0.27, size - 2, size * 0.6, 3);
+	cairo_set_source_rgba(cr, HEXA_CYAN, 1.0);
+	cairo_fill(cr);
+	cairo_restore(cr);
+}
+
+/* A ">" (right) or "<" (left) arrow centered at x, y */
+static void
+draw_chevron(cairo_t *cr, double x, double y, bool left)
+{
+	double d = left ? 3.5 : -3.5;
+
+	cairo_save(cr);
+	cairo_move_to(cr, x + d, y - 6);
+	cairo_line_to(cr, x - d, y);
+	cairo_line_to(cr, x + d, y + 6);
+	cairo_set_line_width(cr, 2);
+	cairo_set_line_cap(cr, CAIRO_LINE_CAP_ROUND);
+	cairo_set_line_join(cr, CAIRO_LINE_JOIN_ROUND);
+	cairo_set_source_rgba(cr, 1, 1, 1, 0.7);
+	cairo_stroke(cr);
+	cairo_restore(cr);
 }
 
