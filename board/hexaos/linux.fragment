# hexaOS changes on top of the kernel's x86_64_defconfig
CONFIG_LOCALVERSION="-hexaos"
CONFIG_DEFAULT_HOSTNAME="hexaos"

# Boot UEFI
CONFIG_EFI=y
CONFIG_EFI_STUB=y

# Automatic /dev (required by eudev)
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Graphical console via the UEFI framebuffer (works in QEMU and on the laptop)
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_DRM_PANIC=y

# QEMU virtual devices
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM_VIRTIO=y

# Root filesystem
CONFIG_EXT4_FS=y

# ===== Laptop: Samsung Galaxy Book4 Pro (Intel Core Ultra / Meteor Lake) =====

# SSD NVMe
CONFIG_BLK_DEV_NVME=y

# Intel Arc graphics (i915; firmware in /lib/firmware/i915)
CONFIG_DRM_I915=m
CONFIG_BACKLIGHT_CLASS_DEVICE=y

# Wi-Fi Intel AX211 (iwlwifi; firmware iwlwifi-so-a0-gf-a0)
CONFIG_RFKILL=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
CONFIG_IWLMLD=m

# Built-in touchpad and keyboard (I2C-HID via the Intel LPSS controller)
CONFIG_MFD_INTEL_LPSS_PCI=y
CONFIG_MFD_INTEL_LPSS_ACPI=y
CONFIG_INTEL_IDMA64=y
CONFIG_PINCTRL=y
CONFIG_GPIOLIB=y
CONFIG_PINCTRL_METEORLAKE=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_I2C_DESIGNWARE_PCI=y
CONFIG_I2C_HID_ACPI=m
CONFIG_HID_MULTITOUCH=m

# Samsung-specific features (keyboard backlight, performance modes)
CONFIG_SAMSUNG_GALAXYBOOK=m

# Audio: Intel DSP (SOF) + Realtek codec + digital microphones
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_GENERIC=m
CONFIG_SND_HDA_CODEC_REALTEK=m
CONFIG_SND_HDA_CODEC_HDMI=m
CONFIG_SND_HDA_CODEC_HDMI_INTEL=m
CONFIG_SND_SOC=m
CONFIG_SND_SOC_SOF_TOPLEVEL=y
CONFIG_SND_SOC_SOF_PCI=m
CONFIG_SND_SOC_SOF_INTEL_TOPLEVEL=y
CONFIG_SND_SOC_SOF_METEORLAKE=m
CONFIG_SND_SOC_SOF_HDA_LINK=y
CONFIG_SND_SOC_SOF_HDA_AUDIO_CODEC=y
CONFIG_SND_SOC_INTEL_SST_TOPLEVEL=y
CONFIG_SND_SOC_INTEL_MACH=y
CONFIG_SND_SOC_INTEL_SKL_HDA_DSP_GENERIC_MACH=m
CONFIG_SND_SOC_DMIC=m

# Speakers: the MAX98390 amplifier driver is built by package/hexa-max98390.
# /dev/i2c-N lets /etc/init.d/S12speakers find which amplifiers answer.
CONFIG_I2C_CHARDEV=m

# Wine: allow 16/32-bit Windows programs and emulated system calls
CONFIG_IA32_EMULATION=y
CONFIG_MODIFY_LDT_SYSCALL=y
# Wine: Windows-style sync objects in the kernel (/dev/ntsync), so threads
# wait on events/mutexes without a round trip to wineserver (faster games)
CONFIG_NTSYNC=y

# Firefox/VS Code sandbox and rootless containers
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# Docker ("hexa-dev" development environment)
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_BPF=y
CONFIG_CPUSETS=y
CONFIG_BPF_SYSCALL=y
CONFIG_POSIX_MQUEUE=y
CONFIG_KEYS=y
CONFIG_OVERLAY_FS=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NETFILTER_XTABLES=y
# Since kernel 6.17 the legacy x_tables backend is opt-in; without it the
# filter/nat/mangle tables used by (legacy) iptables and Docker are dropped.
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP6_NF_IPTABLES_LEGACY=y
CONFIG_IP_NF_RAW=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_NF_TABLES=y
CONFIG_NFT_COMPAT=y

# VPN: WireGuard (hexa-vpn, wg-quick) and TUN (OpenVPN and other VPN apps).
# wg-quick sends all traffic through the tunnel with policy routing (fwmark
# rules) and marks its packets with CONNMARK in the raw/mangle tables.
CONFIG_WIREGUARD=y
CONFIG_TUN=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NETFILTER_XT_CONNMARK=y
CONFIG_IP6_NF_RAW=y

# Game controllers (Xbox, PlayStation, Switch) and virtual input
CONFIG_INPUT_JOYDEV=m
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_XPAD=m
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_HID_SONY=m
CONFIG_HID_PLAYSTATION=m
CONFIG_HID_NINTENDO=m
CONFIG_HIDRAW=y
CONFIG_UHID=m
CONFIG_INPUT_UINPUT=m

# USB drives and external disks (FAT, exFAT, NTFS) and AppImages (FUSE)
CONFIG_USB_STORAGE=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=m
CONFIG_NTFS3_FS=m
CONFIG_FUSE_FS=m
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
