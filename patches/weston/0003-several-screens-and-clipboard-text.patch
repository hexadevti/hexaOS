+/*
+ * hexaOS, several screens: the screen that holds most of a window, from its
+ * position and size. Unlike surface->output this also works while the window
+ * is minimized (its view is then on no shown layer, so libweston gives it no
+ * output, and Weston used to pick the primary screen). NULL when the window is
+ * on no screen at all.
+ */
+static struct weston_output *
+shell_surface_overlapping_output(struct shell_surface *shsurf)
+{
+	struct weston_surface *surface =
+		weston_desktop_surface_get_surface(shsurf->desktop_surface);
+	struct weston_output *output, *best = NULL;
+	struct weston_geometry geo;
+	struct weston_coord_global pos;
+	int64_t area, best_area = 0;
+	int32_t x1, y1, x2, y2;
+
+	geo = weston_desktop_surface_get_geometry(shsurf->desktop_surface);
+	if (geo.width <= 0 || geo.height <= 0) {
+		geo.x = 0;
+		geo.y = 0;
+		geo.width = surface->width;
+		geo.height = surface->height;
+	}
+	pos = weston_view_get_pos_offset_global(shsurf->view);
+
+	wl_list_for_each(output, &surface->compositor->output_list, link) {
+		if (output->destroying)
+			continue;
+		x1 = MAX((int32_t) pos.c.x + geo.x, (int32_t) output->pos.c.x);
+		y1 = MAX((int32_t) pos.c.y + geo.y, (int32_t) output->pos.c.y);
+		x2 = MIN((int32_t) pos.c.x + geo.x + geo.width,
+			 (int32_t) output->pos.c.x + output->width);
+		y2 = MIN((int32_t) pos.c.y + geo.y + geo.height,
+			 (int32_t) output->pos.c.y + output->height);
+		if (x2 <= x1 || y2 <= y1)
+			continue;
+		area = (int64_t) (x2 - x1) * (y2 - y1);
+		if (area > best_area) {
+			best = output;
+			best_area = area;
+		}
+	}
+	return best;
+}
+
+/* The screen a window belongs to: where most of it is, else the screen it was
+ * last maximized or full screen on, else the focused or default one */
+static struct weston_output *
+shell_surface_find_output(struct shell_surface *shsurf)
+{
+	struct weston_surface *surface =
+		weston_desktop_surface_get_surface(shsurf->desktop_surface);
+	struct weston_output *output = shell_surface_overlapping_output(shsurf);
+
+	if (!output)
+		output = shsurf->output;
+	if (!output)
+		output = weston_shell_utils_get_focused_output(surface->compositor);
+	if (!output)
+		output = weston_shell_utils_get_default_output(surface->compositor);
+	return output;
+}
+
+/* Centers a window in the work area of OUTPUT */
+static void
+shell_surface_center_on_output(struct shell_surface *shsurf,
+			       struct weston_output *output)
+{
+	pixman_rectangle32_t area;
+	struct weston_geometry geo;
+	struct weston_coord_global pos;
+	struct weston_coord_surface offset;
+	int32_t x, y;
+
+	get_output_work_area(shsurf->shell, output, &area);
+	geo = weston_desktop_surface_get_geometry(shsurf->desktop_surface);
+	x = area.x + MAX(0, ((int32_t) area.width - geo.width) / 2);
+	y = area.y + MAX(0, ((int32_t) area.height - geo.height) / 2);
+	pos.c = weston_coord(x, y);
+	offset = weston_coord_surface(-geo.x, -geo.y, shsurf->view->surface);
+	weston_view_set_position_with_offset(shsurf->view, pos, offset);
+}
+
 static void
 unset_maximized(struct shell_surface *shsurf)
 {
 	struct weston_surface *surface =
 		weston_desktop_surface_get_surface(shsurf->desktop_surface);
+	/* the screen it was maximized on */
+	struct weston_output *max_output = shsurf->output;
 
 	/* undo all maximized things here */
 	shell_surface_set_output(shsurf,
 			weston_shell_utils_get_default_output(surface->compositor));
 
+	/* hexaOS: go back to where the window was before; if it opened
+	 * maximized (no such place), or that place is on no screen any more,
+	 * center it on the screen it was maximized on, not on the screen
+	 * under the pointer (e.g. the taskbar used to restore it). */
 	if (shsurf->saved_position_valid)
 		weston_view_set_position(shsurf->view, shsurf->saved_pos);
-	else
+	if (max_output && (!shsurf->saved_position_valid ||
+			   !shell_surface_overlapping_output(shsurf)))
+		shell_surface_center_on_output(shsurf, max_output);
+	else if (!shsurf->saved_position_valid)
 		weston_view_set_initial_position(shsurf->view, shsurf->shell);
 	shsurf->saved_position_valid = false;
 
@@ -2627,8 +2721,8 @@ set_maximized(struct shell_surface *shsurf, bool maximized)
 
 		if (!weston_surface_is_mapped(surface))
 			output = weston_shell_utils_get_focused_output(surface->compositor);
-		else
-			output = surface->output;
+		else	/* hexaOS: its own screen, even when minimized */
+			output = shell_surface_find_output(shsurf);
 
 		shell_surface_set_output(shsurf, output);
 
@@ -3346,9 +3440,11 @@ desktop_shell_window_set_maximized(struct wl_client *client,
 	if (!shsurf || shell->locked)
 		return;
 
-	/* the client resizes and commits; the taskbar hears about it then */
-	set_maximized(shsurf, maximized != 0);
+	/* Bring it back from minimized first (on its own screen), then
+	 * maximize or restore it there. The client resizes and commits; the
+	 * taskbar hears about it then. */
 	desktop_shell_window_activate(client, resource, id);
+	set_maximized(shsurf, maximized != 0);
 }
 
