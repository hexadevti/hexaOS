BR2_x86_64=y
BR2_x86_x86_64_v2=y
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_HEXAOS_PATH)/patches"
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_X86_64_V2_GLIBC_STABLE=y
BR2_TARGET_GENERIC_HOSTNAME="hexaos"
BR2_TARGET_GENERIC_ISSUE="Bem-vindo ao hexaOS"
BR2_TARGET_GENERIC_ROOT_PASSWD=""
BR2_TARGET_GENERIC_GETTY_PORT="tty2"
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_SYSTEM_DHCP="eth0"
BR2_GENERATE_LOCALE="pt_BR.UTF-8 en_US.UTF-8"
BR2_TARGET_TZ_INFO=y
BR2_TARGET_LOCALTIME="America/Sao_Paulo"
BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_HEXAOS_PATH)/board/hexaos/users.txt"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_HEXAOS_PATH)/board/hexaos/rootfs_overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_HEXAOS_PATH)/board/hexaos/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_HEXAOS_PATH)/board/hexaos/post-image.sh"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_LATEST_VERSION=y
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_HEXAOS_PATH)/board/hexaos/linux.fragment"
BR2_LINUX_KERNEL_INSTALL_TARGET=y
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
# Firmware: Wi-Fi AX211, video Intel, microcodigo da CPU
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_6E=y
BR2_PACKAGE_LINUX_FIRMWARE_I915=y
BR2_PACKAGE_INTEL_MICROCODE=y
# Fontes
BR2_PACKAGE_DEJAVU=y
# Interface grafica: Weston + terminal foot + tela de boot
BR2_PACKAGE_WESTON=y
BR2_PACKAGE_WESTON_DEFAULT_DRM=y
BR2_PACKAGE_WESTON_SHELL_DESKTOP=y
BR2_PACKAGE_WESTON_DEMO_CLIENTS=y
BR2_PACKAGE_FOOT=y
BR2_PACKAGE_PSPLASH=y
BR2_PACKAGE_PSPLASH_IMAGE="$(BR2_EXTERNAL_HEXAOS_PATH)/board/hexaos/art/splash-logo.png"
BR2_PACKAGE_SEATD=y
BR2_PACKAGE_SEATD_DAEMON=y
# Audio
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_ALSAMIXER=y
BR2_PACKAGE_ALSA_UTILS_SPEAKER_TEST=y
# Rede: Wi-Fi com iwd (comando iwctl)
BR2_PACKAGE_DBUS=y
BR2_PACKAGE_IWD=y
BR2_PACKAGE_WIRELESS_REGDB=y
# DNS do Wi-Fi: o iwd entrega os servidores DNS ao resolvconf (ver etc/iwd/main.conf)
BR2_PACKAGE_OPENRESOLV=y
# Internet com HTTPS (curl + certificados) e git: necessarios para o Claude Code
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y
BR2_PACKAGE_LIBCURL_OPENSSL=y
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_GIT=y
# Pacotes proprios: Wine 64-bit (WoW64) e firmware de audio SOF
BR2_PACKAGE_HEXA_WINE=y
BR2_PACKAGE_HEXA_SOF_BIN=y
# Ferramentas
BR2_PACKAGE_BASH=y
BR2_PACKAGE_HTOP=y
BR2_PACKAGE_NANO=y
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_KMOD_TOOLS=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="3G"
# BR2_TARGET_ROOTFS_TAR is not set
BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_X86_64_EFI=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y
